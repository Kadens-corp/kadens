{# ======================== TERMINER ET COMMENTER ========================
   En bas de séance, à l'endroit où on arrive après avoir lu le programme.
   Le bouton bascule entre « prévue » et « faite » ; « manquée » se choisit au
   calendrier, dans le menu du statut de la pastille ou dans sa modale.

   Ce sont les gestes de **programmation** (attribut EDIT), que le coach fait
   aussi : cocher, noter un écart léger, déplacer, retirer. Le réalisé série par
   série, lui, vit dans le panneau « Réalisé » (`_log_panel`, attribut LOG) — d'où
   le titre, qui ne dit plus « Réalisé » : deux sections de ce nom sur la même
   page, l'une fermée au coach et l'autre pas, ne pourraient que se confondre.

   Fragment isolé parce qu'il est **cible d'un Turbo Stream** : le contrôleur
   re-rend cette section (et la pastille du hero) après un changement de statut,
   sans recharger la page. L'id doit donc survivre au remplacement, et tout ce
   qui dépend du statut (libellé du bouton, statut posté, note) vit ici. #}
{% set isDone = scheduled.status.value == 'done' %}
<section id="schedule-done" class="kd-done" aria-labelledby="done-title">
    <h2 class="kd-done__title" id="done-title">Terminer et commenter</h2>

    <form method="post" action="{{ path('app_scheduled_workout_status', {id: scheduled.id}) }}" class="kd-done__form">
        <input type="hidden" name="_token" value="{{ csrf_token('status' ~ scheduled.id) }}">
        {# Sans ça, l'endpoint renvoie au calendrier : on quitterait la page
           à chaque bascule. #}
        <input type="hidden" name="return" value="schedule">
        <input type="hidden" name="status" value="{{ isDone ? 'planned' : 'done' }}">

        <div class="kd-field">
            <label class="kd-label" for="completion-notes">Commentaire (optionnel)</label>
            <textarea id="completion-notes" name="completionNotes" rows="3"
                      class="kd-input kd-input--area"
                      placeholder="Charge revue à la baisse, dos raide…">{{ scheduled.completionNotes }}</textarea>
        </div>

        {# Séance de force (`strength`, `TrackableSchedule::prescribesStrength`) :
           dire où se saisissent les charges, et dire « Pas de détail » quand la
           séance est faite sans réalisé — l'onglet « Réalisé » n'apparaît pas,
           et rien d'autre sur la page n'expliquait son absence (#63). Ici plutôt
           qu'en tête de page : ce fragment est re-rendu par le flux Turbo du
           statut, la phrase suit donc la bascule « faite » sans rechargement.
           Le coach programme, il ne consigne pas : troisième personne. #}
        {% if strength|default(false) %}
            {{ include('components/_log_in_app.html.twig', {
                missing: isDone and not scheduled.hasLog,
                third: not is_granted('SCHEDULED_WORKOUT_LOG', scheduled)
            }, with_context = false) }}
        {% endif %}

        <button type="submit" class="kd-btn kd-btn--block {{ isDone ? 'kd-btn--secondary' : 'kd-btn--primary' }}">
            {% if isDone %}
                {{ ux_icon('lucide:rotate-ccw') }} Annuler « fait »
            {% else %}
                {{ ux_icon('lucide:check') }} Marquer fait
            {% endif %}
        </button>
    </form>

    <div class="kd-done__secondary">
        <form method="post" action="{{ path('app_scheduled_workout_move', {id: scheduled.id}) }}" class="kd-done__move">
            <input type="hidden" name="_token" value="{{ csrf_token('move' ~ scheduled.id) }}">
            <input type="hidden" name="return" value="schedule">
            <label class="kd-label" for="move-date">Déplacer</label>
            <div class="kd-done__moverow">
                <input type="date" id="move-date" name="scheduledDate"
                       value="{{ scheduled.scheduledDate|date('Y-m-d') }}" class="kd-input" required>
                <button type="submit" class="kd-btn kd-btn--secondary">
                    {{ ux_icon('lucide:calendar-clock') }} Déplacer
                </button>
            </div>
        </form>

        <form method="post" action="{{ path('app_scheduled_workout_delete', {id: scheduled.id}) }}"
              onsubmit="return confirm('Retirer cette séance de l\'agenda ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scheduled.id) }}">
            <button type="submit" class="kd-btn kd-btn--ghost kd-btn--danger">
                {{ ux_icon('lucide:trash-2') }} Retirer de l'agenda
            </button>
        </form>
    </div>
</section>
