{#
    Carte de relation coach ↔ athlète.

    Attend :
      - `relation` : entité Coaching
      - `me`       : utilisateur courant (app.user), pour orienter l'affichage
    Optionnel :
      - `linkAthlete` : lie la carte à l'espace de travail de l'athlète (dashboard coach)

    Côté athlète, la carte porte la liste des droits du coach (#66,
    `_coaching_rights`).

    Le statut réutilise les tokens de statut de séance via CoachingStatus::modifier
    (done / planned / missed), comme GoalOutcome : pas de nouvelle famille de couleur.
#}
{% set other = relation.otherParty(me) %}
{% set iAmCoach = relation.coach == me %}
{% set pending = relation.status.value == 'pending' %}
{% set canRespond = pending and relation.isRecipient(me) %}
{% set canCancel = pending and relation.isRequester(me) %}
{% set workspace = iAmCoach and relation.isActive and (linkAthlete ?? false) %}

<article class="kd-coachcard{{ relation.isActive ? '' : ' is-muted' }}">
    <span class="kd-coachcard__avatar" aria-hidden="true">{{ other ? other.displayName|first|upper : '?' }}</span>

    <div class="kd-coachcard__body">
        <div class="kd-coachcard__top">
            <h3 class="kd-coachcard__name">
                {% if workspace %}
                    <a href="{{ path('app_coach_athlete', {id: other.id}) }}">{{ other.displayName }}</a>
                {% else %}
                    {{ other ? other.displayName : 'Utilisateur supprimé' }}
                {% endif %}
            </h3>
            <span class="kd-badge kd-badge--{{ relation.status.modifier }}">
                {{ ux_icon(relation.status.icon) }} {{ relation.status.label }}
            </span>
        </div>

        <p class="kd-coachcard__role">
            {# Le coaching se noue par email : sous un pseudo, on le rappelle. #}
            {% if other and other.username %}{{ other.email }} · {% endif %}
            {# Tant qu'elle attend, la relation se dit comme une proposition (#79) :
               « Tu entraînes » contredisait le badge En attente. La date est celle
               de la demande : une ligne rouverte (refusée, terminée) garde son
               `createdAt` d'origine, sa réouverture est sa dernière mise à jour. #}
            {% if pending %}
                {% if iAmCoach %}
                    {{ canCancel ? 'Tu as proposé d\'entraîner cette personne' : 'Cette personne te demande de l\'entraîner' }}
                {% else %}
                    {{ canCancel ? 'Tu as demandé à cette personne de t\'entraîner' : 'Cette personne propose de t\'entraîner' }}
                {% endif %}
                · le {{ (relation.updatedAt ?? relation.createdAt)|date('d/m/Y') }}
            {% else %}
                {{ iAmCoach ? 'Tu entraînes cette personne' : 'Cette personne t\'entraîne' }}
            {% endif %}
            {% if not pending and relation.respondedAt %}
                · depuis le {{ relation.respondedAt|date('d/m/Y') }}
            {% endif %}
        </p>

        {# Ce que le coach voit et fait chez l'athlète (#66), montré à l'athlète
           seul : en clair tant qu'il doit répondre, replié une fois la relation
           active (il l'a déjà lu, la carte reste compacte). #}
        {% if not iAmCoach and canRespond %}
            {{ include('components/_coaching_rights.html.twig', {coach: other}) }}
        {% elseif not iAmCoach and relation.isActive %}
            <details class="kd-coachcard__rights">
                <summary>{{ ux_icon('lucide:chevron-down') }} Ce que {{ other ? other.displayName : 'ton coach' }} peut faire</summary>
                {{ include('components/_coaching_rights.html.twig', {coach: other, active: true, title: false}) }}
            </details>
        {% endif %}
    </div>

    <div class="kd-coachcard__actions">
        {% if canRespond %}
            <form method="post" action="{{ path('app_coaching_respond', {id: relation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('coaching_respond' ~ relation.id) }}">
                <input type="hidden" name="decision" value="accept">
                <button type="submit" class="kd-btn kd-btn--primary kd-btn--sm">
                    {{ ux_icon('lucide:user-check') }} Accepter
                </button>
            </form>
            <form method="post" action="{{ path('app_coaching_respond', {id: relation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('coaching_respond' ~ relation.id) }}">
                <input type="hidden" name="decision" value="decline">
                <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm">
                    {{ ux_icon('lucide:user-x') }} Refuser
                </button>
            </form>
        {% elseif canCancel %}
            {# Seul moyen de corriger une faute dans l'email (#79). La demande
               disparaît aussi chez l'autre : pas de confirmation, la renvoyer
               suffit à revenir en arrière. #}
            <form method="post" action="{{ path('app_coaching_cancel', {id: relation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('coaching_cancel' ~ relation.id) }}">
                <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm">
                    {{ ux_icon('lucide:x') }} Annuler la demande
                </button>
            </form>
        {% elseif relation.isActive %}
            {% if workspace %}
                <a href="{{ path('app_coach_athlete', {id: other.id}) }}" class="kd-btn kd-btn--secondary kd-btn--sm">
                    {{ ux_icon('lucide:clipboard-list') }} Programmer
                </a>
            {% endif %}
            {# Le coach est prévenu que ses notes privées partent avec la relation
               (#65). Jamais l'athlète : il ne sait pas qu'elles existent. #}
            {% set endConfirm = 'Terminer cette relation ? Le contenu déjà créé reste chez son propriétaire.' %}
            {% if iAmCoach and relation.coachNotes %}
                {% set endConfirm = endConfirm ~ ' Tes notes privées sur ' ~ other.displayName ~ ' seront effacées.' %}
            {% endif %}
            <form method="post" action="{{ path('app_coaching_end', {id: relation.id}) }}"
                  onsubmit="return confirm({{ endConfirm|json_encode|e('html_attr') }});">
                <input type="hidden" name="_token" value="{{ csrf_token('coaching_end' ~ relation.id) }}">
                <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm">
                    {{ ux_icon('lucide:x') }} Terminer
                </button>
            </form>
        {% endif %}
    </div>
</article>
