{% extends 'base.html.twig' %}

{# ============================================================================
   Vue semaine du calendrier, servie à deux lecteurs.

   `subject` = l'athlète dont on lit l'agenda (`/coach/athlete/{id}/calendar`,
   #77), ou null pour soi. Règle des templates partagés : tous les liens se
   calculent depuis `subject`, sinon le clic suivant ramène le coach sur ses
   propres données. Côté coach, la page garde les gestes sur une séance prévue
   (ouvrir, statut, déplacer, retirer : `ScheduledWorkoutVoter::EDIT`) et perd ce
   qui parle du calendrier du lecteur : bascule mois, ajout depuis SA
   bibliothèque, export et abonnement ICS.
   ============================================================================ #}
{% block title %}{% if subject|default(null) %}Agenda de {{ subject.displayName }} — {% endif %}Semaine — {{ weekLabel }}{% endblock %}

{% block body %}
    {% set subject = subject|default(null) %}
    {% set weekRoute = subject ? 'app_coach_athlete_calendar' : 'app_calendar_week' %}
    {% set weekParams = subject ? {id: subject.id} : {} %}
    {# Ancre des liens sortants : la séance ouverte d'ici repart vers cette
       semaine, chez soi ou dans l'agenda de l'athlète. #}
    {% set backFrom = subject
        ? back_token('athlete-cal', subject.id ~ '-' ~ monday|date('Y-m-d'))
        : back_token('cal-week', monday|date('Y-m-d')) %}
    {% for message in app.flashes('success') %}
        <div data-turbo-temporary class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }}{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div data-turbo-temporary class="kd-flash kd-flash--error" role="alert">{{ ux_icon('lucide:calendar-x') }}{{ message }}</div>
    {% endfor %}

    <div class="kd-pagehead kd-pagehead--cal">
        <div>
            <p class="kd-eyebrow">{{ subject ? 'Son agenda' : 'Planning' }} · Semaine {{ isoWeek }}</p>
            <h1 class="kd-title">{{ weekLabel }}</h1>
            {% if subject %}<p class="kd-pagehead__lead">{{ subject.displayName }}</p>{% endif %}
        </div>

        <div class="kd-calhead">
            {% if not subject %}
            <div class="kd-viewtoggle" role="group" aria-label="Type de vue">
                <a class="kd-viewtoggle__btn" href="{{ path('app_calendar_month', {year: monthPivot.year, month: monthPivot.month}) }}">
                    {{ ux_icon('lucide:calendar-days') }} Mois
                </a>
                <a class="kd-viewtoggle__btn is-active" aria-current="page" href="{{ path('app_calendar_week', {date: monday|date('Y-m-d')}) }}">
                    {{ ux_icon('lucide:calendar-range') }} Semaine
                </a>
            </div>
            {% endif %}

            <nav class="kd-actionbar__end" aria-label="Navigation de la semaine">
                <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path(weekRoute, weekParams|merge({date: prevDate})) }}" aria-label="Semaine précédente">
                    {{ ux_icon('lucide:arrow-left') }}
                </a>
                <a class="kd-btn kd-btn--ghost kd-btn--sm" href="{{ subject ? path(weekRoute, weekParams) : path('app_calendar_week_index') }}">Cette semaine</a>
                <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path(weekRoute, weekParams|merge({date: nextDate})) }}" aria-label="Semaine suivante">
                    {{ ux_icon('lucide:arrow-right') }}
                </a>
                {% if subject %}
                    {# Son historique a sa page coach, gardée par la relation ; le
                       retour de la fiche suffit, il n'y a qu'un chemin d'arrivée. #}
                    <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_coach_athlete_history', {id: subject.id}) }}">
                        {{ ux_icon('lucide:history') }} Historique
                    </a>
                    <a class="kd-btn kd-btn--ghost kd-btn--sm" href="{{ path('app_coach_athlete', {id: subject.id}) }}">
                        {{ ux_icon('lucide:arrow-left') }} Retour à sa fiche
                    </a>
                {% else %}
                    {# L'historique (calendrier annuel du fait) est rangé sous le profil ;
                       le jeton `from` y ramène à la vue quittée au lieu du profil. #}
                    <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_profile_history', back_to('cal-week', monday|date('Y-m-d'))) }}">
                        {{ ux_icon('lucide:history') }} <span class="kd-calhead__label">Historique</span>
                    </a>
                    <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_export_schedule', {year: monthPivot.year, month: monthPivot.month}) }}">
                        {{ ux_icon('lucide:file-down') }} <span class="kd-calhead__label">Exporter en Excel</span>
                    </a>
                    {{ include('calendar/_subscribe.html.twig') }}
                    {{ include('components/_help.html.twig', {topic: 'calendar', title: 'Comment marche le calendrier'}, with_context = false) }}
                {% endif %}
            </nav>
        </div>
    </div>

    {# Bandeau de synthèse de la semaine : charge + observance en un coup d'œil.

       Avec la légende, il se replie sous 560px (#107) : à 390px, en-tête, bilan,
       bandeau d'objectif et légende faisaient ~520px avant la première séance.
       Même motif que la barre de filtres des index : `<details>` rendu ouvert
       (sans JS rien n'est caché), refermé par `collapse` sur téléphone, summary
       masqué au-dessus. Le summary n'est pas un simple « Afficher » : fermé, il
       garde les trois chiffres, seuls les puces et la légende disparaissent.
       Ligne et barre suivent les changements de statut sans rechargement
       (#120) : cf. calendar/_week_summary.html.twig. #}
    {% import 'calendar/_week_summary.html.twig' as weekSummary %}
    <details class="kd-calfold" open data-controller="collapse" data-collapse-media-value="(max-width: 560px)">
        <summary class="kd-calfold__toggle">
            {{ weekSummary.line(summary) }}
            {{ ux_icon('lucide:chevron-down') }}
        </summary>
        {{ weekSummary.bar(summary) }}

        {{ include('calendar/_activity_legend.html.twig') }}
    </details>

    {% if nextGoal %}{{ include('calendar/_goal_banner.html.twig', {goal: nextGoal}) }}{% endif %}

    <div data-controller="caladd"
         data-caladd-preselect-value="{{ preselectPlanId ?? 0 }}"
         data-caladd-focus-value="{{ focusDate ?? '' }}"
         data-caladd-today-value="{{ 'today'|date('Y-m-d') }}">
        {% if subject %}
            {# Poser pour l'athlète part de SA bibliothèque : c'est sa fiche qui le
               fait, la barre d'ajout d'ici puise dans celle du lecteur. #}
            <p class="kd-lead">
                Ouvre une séance pour la lire, la déplacer, changer son statut ou la retirer. Pour en poser une nouvelle, passe par
                <a href="{{ path('app_coach_athlete', {id: subject.id}) }}">sa fiche</a>.
            </p>
        {% else %}
            {{ include('calendar/_addbar.html.twig', {year: monthPivot.year, month: monthPivot.month}) }}
        {% endif %}

        <div class="kd-week">
            {% for day in days %}
                <section data-day="{{ day.date|date('Y-m-d') }}" class="kd-weekday{{ day.isToday ? ' kd-weekday--today' }}{{ day.weekend ? ' kd-weekday--weekend' }}{{ day.isPast and not day.isToday ? ' kd-weekday--past' }}">
                    <header class="kd-weekday__head">
                        <span class="kd-weekday__name">{{ day.dayName }}</span>
                        <span class="kd-weekday__right">
                            <span class="kd-weekday__num">{{ day.date|date('j') }}</span>
                            {% if not subject %}
                                <button type="button" class="kd-calday__add kd-calday__add--week"
                                        data-action="caladd#openWorkout"
                                        data-caladd-date-param="{{ day.date|date('Y-m-d') }}"
                                        aria-label="Ajouter une séance le {{ day.date|date('d/m') }}">
                                    {{ ux_icon('lucide:plus') }}
                                </button>
                            {% endif %}
                        </span>
                    </header>
                    {% for goal in day.goals %}
                        <a href="{{ path('app_goal_show', {id: goal.id}) }}" class="kd-calgoal kd-calgoal--week" title="Priorité : {{ goal.priority.label|lower }} — {{ goal.title }}">
                            {{ ux_icon('lucide:target') }}<span>{{ goal.title }}</span>
                        </a>
                    {% endfor %}
                    <div class="kd-weekday__events">
                        {% for scheduled in day.scheduled %}
                            {{ include('components/_cal_event.html.twig', {
                                scheduled: scheduled,
                                fw: scheduled.workout ? flattened[scheduled.workout.id] : null,
                                instruction: instructions[scheduled.id] ?? null,
                                statuses: statuses,
                                detailed: true,
                                rating: ratings[scheduled.id] ?? null,
                                overdue: day.isPast and scheduled.status.value == 'planned',
                                backFrom: backFrom,
                            }) }}
                        {% else %}
                            <p class="kd-weekday__rest">Repos</p>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock %}
