{# Colonne droite du compositeur : les blocs. Cible des Turbo Streams (#workout-blocks).
   Contexte (blocksContext) : workout, addBlockForm, blockForms, prescribedForms,
   summaries, offProgram (hors programme de la dernière fois, en tête). #}
<div class="kd-cblocks">
    {{ include('components/_off_program.html.twig', {
        recap: offProgram|default(null), workout: workout, context: 'composer'
    }, with_context = false) }}

    {% if workout.blocks is empty %}
        {# Le premier exercice crée le premier bloc (#85) : on n'impose plus la
           notion de bloc avant d'avoir posé quoi que ce soit. Le bouton est le seul
           chemin vers la bibliothèque sous 900px, où elle est une feuille fermée
           et où aucun bloc n'offre encore son « Ajouter un exercice ». #}
        <div class="kd-cblocks__empty">
            {{ ux_icon('lucide:layers') }}
            <p>Séance vide. Choisis un exercice dans la bibliothèque : un premier bloc se crée tout seul.</p>
            <button type="button" class="kd-btn kd-btn--secondary kd-btn--sm" data-action="composer#openLib">
                {{ ux_icon('lucide:plus') }} Ajouter un exercice
            </button>
        </div>
    {% else %}
        {# Tri par position en mémoire : après un déplacement, la PersistentCollection
           garde son ordre de chargement (le #[OrderBy] ne joue qu'au load DB). Sans
           ce tri, le re-render du stream montre l'ordre périmé (corrigé au rechargement). #}
        {% for block in workout.blocks|sort((a, b) => a.position <=> b.position) %}
            {{ include('workout/_block.html.twig', { block: block }) }}
        {% endfor %}
    {% endif %}

    {# Ajout d'un bloc : rôle/tours par défaut (Corps de séance, 1 tour), affinés ensuite. #}
    {{ form_start(addBlockForm, { attr: { class: 'kd-cblocks__add' } }) }}
        <div hidden>
            {{ form_row(addBlockForm.role) }}
            {{ form_row(addBlockForm.rounds) }}
            {{ form_row(addBlockForm.label) }}
        </div>
        <button type="submit" class="kd-cblocks__addbtn">
            {{ ux_icon('lucide:plus') }} Ajouter un bloc
        </button>
    {{ form_end(addBlockForm) }}
</div>
