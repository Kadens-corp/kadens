{# Contenu de #quick-panel : les exercices d'une séance, groupés par bloc, avec
   leurs paramètres éditables. Injecté dans la mini-modale de l'éditeur de plan
   (fetch), re-rendu en entier par Turbo Stream quand son contenu change (ajout
   d'un exercice fait hors programme, action="update").
   Contexte (quickPanelContext) : workout, prescribedForms, summaries,
   supersetLabels (rang « A1 » par id, seulement pour les exercices enchaînés),
   offProgram (ce que l'athlète a fait hors programme la dernière fois).

   Chaque champ s'enregistre seul au changement (#86) : le serveur ne renvoie
   alors que la ligne de résumé de l'exercice (`_quick_exo_summary`).

   Portée volontairement limitée aux valeurs (reps/séries/repos…) : la structure
   (blocs, ordre, glisser-déposer) reste au compositeur, atteignable par le lien
   « Édition complète ». #}
{{ include('components/_off_program.html.twig', {
    recap: offProgram|default(null), workout: workout, context: 'quick'
}, with_context = false) }}

{% if workout.blocks is empty %}
    <p class="kd-quickedit__empty">
        {{ ux_icon('lucide:layers') }}
        Cette séance n'a pas encore de bloc. Ouvre-la dans l'éditeur de séance pour la composer.
    </p>
{% else %}
    {% for block in workout.blocks|sort((a, b) => a.position <=> b.position) %}
        <section class="kd-quickblock">
            <header class="kd-quickblock__head">
                <span class="kd-quickblock__role">
                    {{ block.role.label }}{% if block.label %} · {{ block.label }}{% endif %}
                </span>
                {% if block.rounds > 1 %}
                    <span class="kd-quickblock__rounds">{{ ux_icon('lucide:repeat') }} {{ block.rounds }} tours</span>
                {% endif %}
            </header>

            {% for prescribed in block.prescribedExercises|sort((a, b) => a.position <=> b.position) %}
                <details class="kd-quickexo">
                    {{ include('workout/_quick_exo_summary.html.twig', {
                        prescribed: prescribed,
                        rank: supersetLabels[prescribed.id]|default(null),
                        summary: summaries[prescribed.id]|default(''),
                    }, with_context = false) }}
                    <div class="kd-quickexo__form">
                        {# Enregistrement automatique, comme au compositeur (#86) : un
                           seul mode dans toute l'app, donc pas de bouton ici, et rien
                           à perdre en fermant la modale. #}
                        {{ include('workout/_prescribed_form.html.twig', {
                            form: prescribedForms[prescribed.id],
                            auto_action: 'change->plangrid#submitForm'
                        }) }}
                    </div>
                </details>
            {% else %}
                <p class="kd-quickblock__empty">Aucun exercice dans ce bloc.</p>
            {% endfor %}
        </section>
    {% endfor %}
{% endif %}
