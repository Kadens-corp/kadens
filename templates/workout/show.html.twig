{% extends 'base.html.twig' %}

{% set workout = flat.workout %}

{% block title %}{{ workout.title }}{% endblock %}

{% block body %}
    {% import 'components/_rating.html.twig' as ratings %}

    {# Arrivée d'une copie depuis un lien partagé (#58), partage ouvert ou
       arrêté (#61). #}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}
    {# Vue de consultation auto-suffisante : aucun chargement AJAX post-rendu,
       condition du cache offline. Consomme PlanFlattener + WorkoutMetrics.

       `embed` et non `include` : la barre d'actions se pose dans le hero du
       composant partagé, que la page publique laisse vide. #}
    {% embed 'components/_workout_read.html.twig' with {
        flat: flat, summary: summary, blockStats: blockStats,
        volume: volume, load: load, plates: plates, endurance: endurance
    } only %}
        {% block actions %}
            <div class="kd-wk__bar">
                {{ include('components/_backlink.html.twig', {
                    fallback: 'app_workout_index', kicker: 'Mes séances', class: 'kd-wk__back'
                }) }}

                <div class="kd-wk__baractions">
                    {% if is_granted('WORKOUT_EDIT', flat.workout) %}
                        {# Le maillon de la chaîne « plan → séance → composer » :
                           sans `back_carry()`, le contexte s'arrête ici. #}
                        <a href="{{ path('app_workout_edit', {id: flat.workout.id}|merge(back_carry())) }}"
                           class="kd-btn kd-btn--sm kd-btn--onink">
                            {{ ux_icon('lucide:square-pen') }} Éditer
                        </a>
                    {% endif %}

                    {# Les actions secondaires vivent dans un <details> natif :
                       clavier et sans-JS d'office, comme le menu de compte. Le
                       contrôleur `dismiss` n'ajoute que le confort. #}
                    <details class="kd-kebab" data-controller="dismiss">
                        <summary class="kd-kebab__trigger" aria-label="Plus d'actions">
                            {{ ux_icon('lucide:ellipsis') }}
                        </summary>
                        <div class="kd-kebab__panel">
                            <a href="{{ path('app_export_workout', {id: flat.workout.id}) }}" class="kd-kebab__item">
                                {{ ux_icon('lucide:file-down') }} Exporter en Excel
                            </a>
                            <form method="post" action="{{ path('app_workout_duplicate', {id: flat.workout.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('duplicate' ~ flat.workout.id) }}">
                                <button type="submit" class="kd-kebab__item">
                                    {{ ux_icon('lucide:copy') }} Dupliquer la séance
                                </button>
                            </form>
                        </div>
                    </details>
                </div>
            </div>
        {% endblock %}

        {# Partage par lien (#61) : privé par défaut, ouvert par le propriétaire
           seul. Le composant ne se rend pas pour le coach. #}
        {% block afterhero %}
            {{ include('components/_share_link.html.twig', {
                subject: flat.workout,
                kind: 'workout',
                url: flat.workout.shared ? url('app_public_share', {token: flat.workout.shareToken}) : null,
                action: path('app_workout_share', {id: flat.workout.id}),
                csrf: 'workout_share' ~ flat.workout.id,
            }, with_context = false) }}
        {% endblock %}
    {% endembed %}

    {# Réalisations de la lignée (copies de plan + poses directes au calendrier).
       Hors de `_workout_read` : ce composant sert aussi la page publique, et
       l'historique d'un propriétaire n'a rien à y faire. Absent d'une copie
       locale de plan, qui n'est pas la racine de sa lignée. #}
    {% if instances is not null %}
        <section class="kd-section" aria-labelledby="wk-instances">
            <h2 class="kd-wk__paneltitle" id="wk-instances">Réalisations</h2>
            {% if instances is empty %}
                <div class="kd-card kd-empty">
                    {{ ux_icon('lucide:history') }}
                    <div>Pas encore faite. Ses prochaines poses partiront de la version ci-dessus.</div>
                </div>
            {% else %}
                <ul class="kd-list">
                    {% for scheduled in instances %}
                        <li class="kd-list__row">
                            <div class="kd-list__date">
                                <div class="kd-list__date-day">{{ scheduled.scheduledDate|date('d') }}</div>
                                <div class="kd-list__date-mon">{{ scheduled.scheduledDate|date('m/Y') }}</div>
                            </div>
                            <div class="kd-list__main">
                                <a class="kd-list__title" href="{{ path('app_scheduled_workout_show', {id: scheduled.id}) }}">
                                    {{ scheduled.displayTitle }}
                                </a>
                                <div class="kd-list__meta">
                                    {{ scheduled.sourcePlanTemplate ? scheduled.sourcePlanTemplate.title : 'Posée au calendrier' }}
                                    {% if instanceRatings[scheduled.id] is defined %}
                                        · {{ ratings.badge(instanceRatings[scheduled.id]) }}
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
