{% extends 'base.html.twig' %}

{% block title %}Éditer — {{ template.title }}{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <p class="kd-flash kd-flash--error" role="alert">{{ ux_icon('lucide:x') }} {{ message }}</p>
    {% endfor %}

    <div class="kd-actionbar">
        {{ include('components/_backlink.html.twig', {
            fallback: 'app_plan_template_index', kicker: 'Mes plans', owner: template.owner
        }) }}
        <div class="kd-actionbar__end">
            <a href="{{ path('app_plan_template_show', {id: template.id}|merge(back_carry())) }}" class="kd-btn kd-btn--secondary kd-btn--sm">
                {{ ux_icon('lucide:arrow-right') }} Voir le plan
            </a>
            {{ include('components/_help.html.twig', {topic: 'plan', title: 'Comment marche un plan'}, with_context = false) }}
        </div>
    </div>

    {# Plan d'un athlète édité par son coach : à qui il est (#64). #}
    {{ include('components/_owner_banner.html.twig', {owner: template.owner, kind: 'Plan'}, with_context = false) }}
    {# Et dans l'autre sens, ce qui vient du coach, chez l'athlète (#80). #}
    {{ include('components/_added_by.html.twig', {by: template.addedBy, banner: true, on: template.createdAt}, with_context = false) }}

    {# En-tête à édition en ligne : cliquer le titre ou la description pour les
       modifier (contrôleur `inline-edit`, champs semi-invisibles). C'est le seul
       chemin d'édition des métadonnées : il n'y a plus de formulaire, et le nombre
       de semaines se règle au pied de la trame.
       `rename` (posé par la création en un clic) ouvre le titre d'emblée. #}
    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow">Éditeur de plan</p>
            <h1 class="kd-title kd-inlineedit"
                data-controller="inline-edit"
                data-inline-edit-autofocus-value="{{ app.request.query.get('rename') ? 'true' : 'false' }}"
                data-inline-edit-url-value="{{ path('app_plan_template_meta', {id: template.id}) }}"
                data-inline-edit-token-value="{{ csrf_token('plan_meta' ~ template.id) }}"
                data-inline-edit-field-value="title"
                data-inline-edit-target="display"
                data-value="{{ template.title }}"
                data-action="click->inline-edit#start"
                title="Cliquer pour renommer">{{ template.title }}</h1>

            <p class="kd-lead kd-inlineedit kd-inlineedit--desc{{ template.description ? '' : ' kd-inlineedit--empty' }}"
               data-controller="inline-edit"
               data-inline-edit-url-value="{{ path('app_plan_template_meta', {id: template.id}) }}"
               data-inline-edit-token-value="{{ csrf_token('plan_meta' ~ template.id) }}"
               data-inline-edit-field-value="description"
               data-inline-edit-type-value="textarea"
               data-inline-edit-placeholder-value="+ Ajouter une description"
               data-inline-edit-target="display"
               data-value="{{ template.description }}"
               data-action="click->inline-edit#start"
               title="Cliquer pour modifier">{{ template.description ?: '+ Ajouter une description' }}</p>
            {# Le coach écrit ici pour l'athlète, pas pour lui (#65). #}
            {{ include('components/_visible_to.html.twig', {owner: template.owner}, with_context = false) }}

            {# Coach sur le plan d'un athlète : ce que fait la pose d'une de ses
               propres séances (#58). À qui est le plan, le bandeau propriétaire
               le dit déjà (#64). #}
            {% if composingFor %}
                <p class="kd-editsection__hint">
                    Ses séances et les tiennes sont dans la liste des séances. Si tu ajoutes
                    une des tiennes, elle est d'abord copiée dans sa bibliothèque.
                </p>
            {% endif %}
        </div>
    </div>

    {# « Donner ce plan à » (#58) : le propriétaire le donne à un de ses athlètes,
       sans passer par la fiche coach. Il change de propriétaire, le coach reste
       co-éditeur. Refusé pour un plan déjà posé au calendrier (cf. assign).

       Formulé comme une ACTION, jamais comme un état : aucun athlète n'est
       présélectionné (« Choisir un athlète… »), sinon le bandeau se lisait
       « ce plan est pour Léa » alors que rien n'était donné. La confirmation
       nomme l'athlète choisi, lu dans le DOM au moment de l'envoi. #}
    {% if assignableAthletes is not empty %}
        {% if onCalendar %}
            <p class="kd-editsection__hint">
                Ce plan est déjà sur ton calendrier : il ne peut plus être transféré à un athlète.
                Pour qu'il en ait un, donne-lui une copie depuis sa fiche.
            </p>
        {% else %}
            <form method="post" action="{{ path('app_plan_template_assign', {id: template.id}) }}" class="kd-sharerange"
                  onsubmit="return confirm('Transférer ce plan à ' + this.athlete.selectedOptions[0].text + ' ? Il deviendra le sien, tu resteras co-éditeur. Tes notes privées sur le plan seront effacées.');">
                <input type="hidden" name="_token" value="{{ csrf_token('plan_assign' ~ template.id) }}">
                <label class="kd-sharerange__label" for="plan_assign_athlete">Transférer ce plan à&nbsp;:</label>
                <select class="kd-planweek__select" id="plan_assign_athlete" name="athlete" required>
                    <option value="" selected disabled>Choisir un athlète…</option>
                    {% for athlete in assignableAthletes %}
                        <option value="{{ athlete.id }}">{{ athlete.displayName }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="kd-btn kd-btn--secondary kd-btn--sm">
                    {{ ux_icon('lucide:user-plus') }} Transférer
                </button>
            </form>
        {% endif %}
    {% endif %}

    {# Fourre-tout du propriétaire, replié tant qu'il est vide. C'est ici que se
       construit le déroulé du plan en vrac, avant qu'il devienne des cases. Le
       coach ne le voit pas (garde dans le composant et dans `updateMeta`). #}
    {{ include('components/_private_notes.html.twig', {
        entity: template,
        url: path('app_plan_template_meta', {id: template.id}),
        token: csrf_token('plan_meta' ~ template.id),
    }, with_context = false) }}

    {# Le pendant côté coach : ses notes privées sur l'athlète (#65). #}
    {{ include('components/_coach_notes.html.twig', {coaching: coachRelation}, with_context = false) }}

    {# À quoi sert ce plan. Conteneur cible d'un Turbo Stream : les mutations de
       rattachement ne touchent que son CONTENU (action="update"), l'id survit. #}
    <div id="plan-goals">
        {{ include('plan_template/_goals.html.twig') }}
    </div>

    {# Trame — conteneur cible des Turbo Streams. Le contrôleur `plangrid` porte le
       glisser-déposer inter-cases et la mini-modale d'édition rapide. Il enveloppe
       la grille ET la modale : les mutations de trame ne touchent que le CONTENU de
       #plan-grid (action="update"), la modale et le contrôleur survivent. #}
    <section class="kd-editsection" data-controller="plangrid"
             data-plangrid-grid-url-value="{{ path('app_plan_template_grid', {id: template.id}) }}">
        <p class="kd-editsection__title">Grille du plan</p>
        {# Aide en trois gestes (#67) : le vocabulaire de l'interface (armer,
           tamponner, palette) n'a pas sa place à l'écran. #}
        <ol class="kd-editsection__hint kd-planhelp">
            <li>Choisis une séance dans la liste des séances.</li>
            <li>Clique sur les jours où tu veux la faire. Le « + » d'un jour y ajoute une séance directement.</li>
            <li>Clique sur une case pour l'ajuster. Ça ne change que cette case. Son menu permet de la déplacer, la copier ou la retirer.</li>
        </ol>
        {# Coach sur le plan de son athlète : la note d'une case est une consigne
           qu'il lira, pas un pense-bête (#65). #}
        {{ include('components/_visible_to.html.twig', {owner: template.owner, what: 'Les consignes de case'}, with_context = false) }}
        {# `kd-libsheet` : sous 900px la palette n'est plus un volet empilé au-dessus
           de la trame mais une feuille qui monte du bas, ouverte sur une case précise
           (même mécanique que la bibliothèque du compositeur, cf. components.css). #}
        <div class="kd-planeditor kd-libsheet" data-plangrid-target="sheet">
            {# Voile de la feuille : inerte tant que `kd-libsheet--open` n'est pas
               posée. Purement visuel, la fermeture au clic extérieur est portée par
               le contrôleur, sur le document. #}
            <div class="kd-composer__scrim"></div>
            <div class="kd-composer__lib">
                {{ include('plan_template/_palette.html.twig') }}
            </div>
            <div class="kd-composer__main">
                <div id="plan-grid">
                    {{ include('plan_template/_grid.html.twig') }}
                </div>
            </div>
        </div>

        {# Mini-modale d'édition rapide : le panneau des exercices de la copie locale
           est chargé en fetch dans #quick-panel, puis re-rendu par Turbo Stream à
           chaque enregistrement. data-turbo="false" : Turbo n'intercepte aucun
           formulaire de la modale, le contrôleur applique lui-même les streams. #}
        <dialog class="kd-modal kd-modal--quick" data-plangrid-target="dialog" data-turbo="false"
                data-action="click->plangrid#backdrop">
            <div class="kd-modal__card kd-modal__card--quick">
                <header class="kd-modal__head">
                    <span class="kd-modal__title">{{ ux_icon('lucide:sliders-horizontal') }} Modifier cette case seulement</span>
                    <div class="kd-modal__headactions">
                        <a data-plangrid-target="fullLink" href="#" class="kd-btn kd-btn--secondary kd-btn--sm">
                            {{ ux_icon('lucide:square-pen') }} Ouvrir dans l'éditeur de séance
                        </a>
                        <button type="button" class="kd-modal__close" data-action="plangrid#close" aria-label="Fermer">
                            {{ ux_icon('lucide:x') }}
                        </button>
                    </div>
                </header>
                <div id="quick-panel" class="kd-quickedit" data-plangrid-target="panel"></div>
            </div>
        </dialog>
    </section>

    {# Dupliquer #}
    <section class="kd-editsection">
        <p class="kd-editsection__title">Dupliquer</p>
        <div class="kd-card" style="max-width:640px;">
            <form method="post" action="{{ path('app_plan_template_duplicate', {id: template.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('duplicate' ~ template.id) }}">
                <button type="submit" class="kd-btn kd-btn--secondary">
                    {{ ux_icon('lucide:copy') }} Dupliquer ce plan
                </button>
            </form>
        </div>
    </section>

    {# Zone dangereuse #}
    <section class="kd-editsection">
        <p class="kd-editsection__title">Zone dangereuse</p>
        {{ include('plan_template/_delete_form.html.twig') }}
    </section>
{% endblock %}
