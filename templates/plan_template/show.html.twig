{% extends 'base.html.twig' %}

{% block title %}{{ flat.template.title }}{% endblock %}

{% block body %}
    {# Arrivée d'une copie depuis un lien partagé (#58), partage ouvert ou
       arrêté (#61). #}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    {# Vue de consultation auto-suffisante : aucun chargement AJAX post-rendu,
       condition du cache offline (Phase 9). Consomme la sortie de PlanFlattener. #}
    <div class="kd-actionbar">
        {{ include('components/_backlink.html.twig', {
            fallback: 'app_plan_template_index', kicker: 'Mes plans', owner: flat.template.owner
        }) }}

        <div class="kd-actionbar__end">
            {# L'action clé du produit, depuis le plan lui-même (#68) : ouvre la
               modale du calendrier sur ce plan. Le seul autre lecteur que les
               voters laissent entrer est le coach du propriétaire (cf.
               `_owner_banner`) : il le place depuis la fiche de son athlète.
               Comparaison par `id` : `owner` peut être un proxy. #}
            {% set planOwner = flat.template.owner %}
            {% if planOwner is not null and app.user and planOwner.id == app.user.id %}
                <a href="{{ path('app_calendar_index', {place: flat.template.id}) }}" class="kd-btn kd-btn--primary kd-btn--sm">
                    {{ ux_icon('lucide:calendar-plus') }} Placer dans mon agenda
                </a>
            {% elseif planOwner is not null and app.user %}
                <a href="{{ path('app_coach_athlete', {id: planOwner.id, plan: flat.template.id}) }}#placer-un-plan" class="kd-btn kd-btn--primary kd-btn--sm">
                    {{ ux_icon('lucide:calendar-plus') }} Placer dans son agenda
                </a>
            {% endif %}
            <a href="{{ path('app_plan_template_edit', {id: flat.template.id}|merge(back_carry())) }}" class="kd-btn kd-btn--secondary kd-btn--sm">
                {{ ux_icon('lucide:square-pen') }} Éditer
            </a>
            <a href="{{ path('app_export_plan_template', {id: flat.template.id}) }}" class="kd-btn kd-btn--ghost kd-btn--sm">
                {{ ux_icon('lucide:file-down') }} Excel
            </a>
        </div>
    </div>

    {# Plan d'un athlète ouvert par son coach : à qui il est (#64). #}
    {{ include('components/_owner_banner.html.twig', {owner: flat.template.owner, kind: 'Plan'}, with_context = false) }}

    {# Partage par lien (#61) : privé par défaut, ouvert par le propriétaire seul
       (le composant ne se rend pas pour le coach). Une fois ouvert, on peut aussi
       envoyer une plage de semaines : un filtre de la même adresse, pas un
       second lien. #}
    {% set shareUrl = flat.template.shared ? url('app_public_share_plan', {token: flat.template.shareToken}) : null %}
    {% embed 'components/_share_link.html.twig' with {
        subject: flat.template,
        kind: 'plan',
        url: shareUrl,
        action: path('app_plan_template_share', {id: flat.template.id}),
        csrf: 'plan_share' ~ flat.template.id,
    } only %}
        {% block shared_extra %}
            {% if subject.durationWeeks > 1 %}
                <div class="kd-sharerange" data-controller="share-range"
                     data-share-range-base-value="{{ url }}">
                    <span class="kd-sharerange__label">Ou seulement des semaines&nbsp;:</span>
                    <select class="kd-planweek__select" data-share-range-target="from" aria-label="Semaine de début">
                        {% for w in 1..subject.durationWeeks %}<option value="{{ w }}">S{{ w }}</option>{% endfor %}
                    </select>
                    <span aria-hidden="true">→</span>
                    <select class="kd-planweek__select" data-share-range-target="to" aria-label="Semaine de fin">
                        {% for w in 1..subject.durationWeeks %}<option value="{{ w }}"{{ w == subject.durationWeeks ? ' selected' }}>S{{ w }}</option>{% endfor %}
                    </select>
                    <button type="button" class="kd-btn kd-btn--secondary kd-btn--sm" data-action="share-range#copy">
                        {{ ux_icon('lucide:link-2') }} Copier le lien de ces semaines
                    </button>
                    <span class="kd-actionbar__feedback" data-share-range-target="feedback" role="status" aria-live="polite"></span>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {{ include('components/_plan_read.html.twig') }}

    {{ include('components/_progression.html.twig', {
        volume: progression.volume,
        trajectories: progression.trajectories,
        adherence: progression.adherence,
        anchors: progression.anchors,
        anchor: progression.anchor,
        planId: flat.template.id,
    }) }}
{% endblock %}
