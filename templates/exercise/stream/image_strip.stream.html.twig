{# Réponse à un geste sur les images d'un exercice (#38) : seule sa bande
   d'images est remplacée, là où elle est (planche ou éditeur). Une erreur
   éventuelle est un flash ordinaire, rendu en toast dans la pile du coin. #}
<turbo-stream action="replace" target="exercise-images-{{ exercise.id }}">
    <template>
        {{ include('exercise/_image_strip.html.twig', {exercise: exercise, from: from}, with_context = false) }}
    </template>
</turbo-stream>
<turbo-stream action="append" targets=".kd-toasts">
    <template>
        {{ include('components/_flash_toasts.html.twig', {}, with_context = false) }}
    </template>
</turbo-stream>
