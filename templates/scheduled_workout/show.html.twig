{% extends 'base.html.twig' %}

{% block title %}{{ scheduled.displayTitle }} — {{ scheduled.scheduledDate|date('d/m/Y') }}{% endblock %}

{% block body %}
    {# Les retours des gestes qui redirigent ici (rattacher une activité,
       effacer le réalisé) : sans eux, le message restait en session et surgissait
       sur une autre page. #}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    {# Séance datée d'un athlète ouverte par son coach : à qui elle est (#64). #}
    {{ include('components/_owner_banner.html.twig', {owner: scheduled.owner, kind: 'Séance'}, with_context = false) }}
    {# Et dans l'autre sens, ce qui vient du coach, chez l'athlète (#80) : posée
       par lui au calendrier, ou seulement écrite par lui (l'athlète a placé
       lui-même le plan de son coach). #}
    {{ include('components/_added_by.html.twig', scheduled.addedBy
        ? {by: scheduled.addedBy, banner: true, verb: 'Posée par', on: scheduled.createdAt}
        : {by: scheduled.contributor, banner: true, verb: 'Préparée par'}, with_context = false) }}

    {# Séance dans son contexte daté. La page de bibliothèque (app_workout_show)
       montre la même séance mais ne connaît aucune date : c'est ici, et seulement
       ici, que se boucle le « prévu vs réalisé ».

       `flat` est **null** quand la séance datée n'a pas de source : séance libre,
       ou séance de bibliothèque supprimée depuis (la FK est en SET NULL, une
       séance réellement faite ne disparaît pas avec sa source). Il n'y a alors
       aucun programme à rendre, seulement le titre snapshot, la date, le statut —
       et le réalisé, qui est tout entier « hors programme ». #}
    {% if flat %}
        {# Même composant de lecture que la page de bibliothèque et la page
           publique, en `embed` pour pouvoir remplir le bloc `actions` du hero.

           `only` isole le composant : ce que le bloc `actions` utilise doit être
           passé ici explicitement, la portée du template appelant n'y entre pas.

           `comparison` / `logSummary` / `defaultTab` sont les trois paramètres du
           réalisé, et cette page est la SEULE à les passer : la bibliothèque et la
           page publique rendent le même composant à l'identique sans eux. #}
        {% embed 'components/_workout_read.html.twig' with {
            flat: flat, summary: summary, blockStats: blockStats,
            scheduled: scheduled,
            comparison: comparison, logSummary: logSummary, defaultTab: defaultTab,
            volume: volume|default(null), load: load|default(null),
            plates: plates|default([]), endurance: endurance|default([]),
            eyebrow: 'Séance au calendrier', summaryContext: summaryContext,
            planInstruction: planInstruction
        } only %}
            {% block actions %}
                {{ include('scheduled_workout/_hero_actions.html.twig', {
                    scheduled: scheduled, workout: flat.workout
                }) }}
            {% endblock %}
            {# Le bilan, avant le programme : c'est ce qui distingue cette page
               de la séance type (#91). #}
            {# La consigne de la case du plan (#95), avant le bilan : c'est ce
               qu'on lit avant de faire la séance. #}
            {% block afterhero %}
                {{ include('components/_plan_instruction.html.twig', {instruction: planInstruction}, with_context = false) }}
                {{ include('components/_scheduled_summary.html.twig', summaryContext, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {% else %}
        <article class="kd-wk">
            <header class="kd-wk__hero">
                <div class="kd-wk__heroinner">
                    {{ include('scheduled_workout/_hero_actions.html.twig', {
                        scheduled: scheduled, workout: null
                    }) }}

                    <div class="kd-wk__herobody">
                        <div class="kd-wk__herotitle">
                            <p class="kd-wk__eyebrow">Séance libre</p>
                            <h1 class="kd-wk__title">{{ scheduled.displayTitle }}</h1>
                        </div>
                    </div>
                </div>
            </header>

            {{ include('components/_plan_instruction.html.twig', {instruction: planInstruction}, with_context = false) }}
            {{ include('components/_scheduled_summary.html.twig', summaryContext, with_context = false) }}

            {# Sans source, il n'y a rien à comparer : pas de colonne « Prévu »,
               seulement le réalisé — le tableau la fait tomber de lui-même quand
               aucune ligne n'a de prescrit en face. Pas d'onglets non plus, il n'y
               a qu'une lecture possible. #}
            {% if comparison is not empty %}
                <section class="kd-wk__panel" aria-labelledby="wk-panel-realise">
                    <h2 class="kd-wk__paneltitle" id="wk-panel-realise">Réalisé</h2>
                    {{ include('components/_log_panel.html.twig', {
                        scheduled: scheduled, flat: null,
                        comparison: comparison, logSummary: logSummary
                    }, with_context = false) }}
                </section>
            {% else %}
                <div class="kd-card kd-empty">
                    {{ ux_icon('lucide:clipboard-list') }}
                    <div>Cette séance n'a pas de programme prévu.</div>
                </div>
            {% endif %}
        </article>
    {% endif %}

    {# Le réalisé cardio importé. Hors du composant de lecture partagé : la
       bibliothèque et la page publique ne connaissent aucune date, donc aucune
       sortie réellement courue. #}
    {{ include('components/_imported_activity.html.twig', {
        scheduled: scheduled,
        activities: importedActivities,
        comparison: activityComparison,
        attachable: attachableActivities
    }, with_context = false) }}

    {# Statut, commentaire et ressenti : un seul formulaire, le même que la
       modale du calendrier (#90, #91). Gestes de programmation (EDIT), que le
       coach fait aussi ; le ressenti, lui, ne s'y saisit qu'au propriétaire
       (LOG). Sorti en composant : c'est une cible du Turbo Stream renvoyé à
       l'enregistrement. #}
    {% if is_granted('SCHEDULED_WORKOUT_EDIT', scheduled) %}
        {{ include('components/_scheduled_done.html.twig', {
            scheduled: scheduled, rating: summaryContext.rating, statuses: statuses
        }, with_context = false) }}
    {% endif %}
{% endblock %}
