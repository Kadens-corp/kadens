{% extends 'base.html.twig' %}

{% block title %}{{ athlete.displayName }} — Espace coach — Kadens{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p data-turbo-temporary class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <p data-turbo-temporary class="kd-flash kd-flash--error" role="alert">{{ ux_icon('lucide:x') }} {{ message }}</p>
    {% endfor %}

    {# ============================== EN-TÊTE ATHLÈTE ========================= #}
    <header class="kd-phero">
        <span class="kd-phero__avatar" aria-hidden="true">{{ athlete.displayName|first|upper }}</span>
        <div class="kd-phero__main">
            <p class="kd-eyebrow kd-eyebrow--accent">Athlète suivi</p>
            <h1 class="kd-phero__name">{{ athlete.displayName }}</h1>
            {% set vitals = [
                athlete.age is not null ? athlete.age ~ ' ans',
                athlete.sex ? athlete.sex.label,
                athlete.weightKg is not null ? athlete.weightKg|weight,
                athlete.mainGoal ? athlete.mainGoal.label,
                athlete.trainingYears is not null ? athlete.trainingYears ~ ' an' ~ (athlete.trainingYears > 1 ? 's') ~ ' de pratique',
            ]|filter(v => v) %}
            {% if vitals is not empty %}
                <ul class="kd-vitals">
                    {% for v in vitals %}<li class="kd-vitals__item">{{ v }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
        {# Les mêmes pages détaillées que sur son propre profil, lues à son nom :
           le résumé ProfileStats plus bas ne répond ni « sur quelle fenêtre » ni
           « quels jours ». Sans elles, un coach devait deviner — ou pire, lisait
           les siennes sans s'en rendre compte. #}
        <div class="kd-phero__actions">
            <a href="{{ path('app_coach_athlete_stats', {id: athlete.id}) }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:chart-column') }} Ses statistiques
            </a>
            <a href="{{ path('app_coach_athlete_history', {id: athlete.id}) }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:history') }} Son historique
            </a>
            <a href="{{ path('app_coaching_index') }}#athletes" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:arrow-left') }} Mes athlètes
            </a>
            {{ include('components/_help.html.twig', {topic: 'athlete', title: 'Comment marche cette fiche', athlete: athlete}, with_context = false) }}
        </div>
    </header>

    {# Tes notes sur lui (#65) : la seule chose de la fiche qu'il ne verra jamais.
       Aussi rappelées en tête du compositeur et de l'éditeur de plan. #}
    {{ include('components/_coach_notes.html.twig', {coaching: coaching}, with_context = false) }}

    {# ------------------------------ SES OBJECTIFS --------------------------- #}
    {% if goals is not empty %}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Cap</p>
                    <h2 class="kd-title kd-title--sm">Ses prochaines échéances</h2>
                </div>
            </div>
            <div class="kd-goallist kd-section__block">
                {% for goal in goals %}
                    {{ include('goal/_card.html.twig', {goal: goal}) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ------------------------------- CRÉER ---------------------------------- #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Créer</p>
                <h2 class="kd-title kd-title--sm">Programmer pour {{ athlete.displayName }}</h2>
                <p class="kd-lead">Ce que tu crées ici lui appartient : tu le remplis ensuite dans l'éditeur habituel.</p>
            </div>
        </div>

        <div class="kd-grid kd-grid--2 kd-section__block">
            <section class="kd-card">
                <h3 class="kd-card__title">{{ ux_icon('lucide:clipboard-list') }} Nouvelle séance</h3>
                <form method="post" action="{{ path('app_coach_workout_new', {id: athlete.id}) }}" class="kd-coachform">
                    <input type="hidden" name="_token" value="{{ csrf_token('coach_workout_new' ~ athlete.id) }}">
                    <div class="kd-field kd-coachform__field">
                        <label class="kd-label" for="coach_workout_title">Titre de la séance</label>
                        <input class="kd-input" type="text" id="coach_workout_title" name="title"
                               placeholder="Sortie longue en Z2" required>
                    </div>
                    <button type="submit" class="kd-btn kd-btn--primary">
                        {{ ux_icon('lucide:plus') }} Créer et ouvrir
                    </button>
                </form>
            </section>

            {# Une séance de SA bibliothèque à lui, copiée chez l'athlète : l'original
               reste intact, la copie appartient à l'athlète (#58). Le dire avant
               l'envoi, et prévenir le doublon quand il en a déjà une copie (#82). #}
            <section class="kd-card">
                <h3 class="kd-card__title">{{ ux_icon('lucide:copy') }} Une de mes séances</h3>
                {% if coachWorkouts is empty %}
                    <p class="kd-lead">Tu n'as pas encore de séance : crée-en une dans « Mes séances ».</p>
                {% else %}
                    <p class="kd-coachform__hint">Une copie indépendante sera créée chez {{ athlete.displayName }}. Tes modifications futures ne la toucheront pas.</p>
                    <form method="post" action="{{ path('app_coach_workout_copy', {id: athlete.id}) }}" class="kd-coachform"
                          data-controller="copy-notice"
                          data-copy-notice-copies-value="{{ existingCopies|json_encode(constant('JSON_FORCE_OBJECT')) }}"
                          data-copy-notice-name-value="{{ athlete.displayName }}"
                          data-action="change->copy-notice#update">
                        <input type="hidden" name="_token" value="{{ csrf_token('coach_workout_copy' ~ athlete.id) }}">
                        <div class="kd-field kd-coachform__field">
                            <label class="kd-label" for="coach_workout_copy">Séance à lui donner</label>
                            <select class="kd-input" id="coach_workout_copy" name="workout" required
                                    data-copy-notice-target="workout">
                                {% for workout in coachWorkouts %}
                                    <option value="{{ workout.id }}">{{ workout.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="kd-btn kd-btn--primary">
                            {{ ux_icon('lucide:plus') }} <span data-copy-notice-target="label">Ajouter à sa bibliothèque</span>
                        </button>
                        <p class="kd-coachform__notice" data-copy-notice-target="notice" role="status" hidden>
                            {{ ux_icon('lucide:copy') }}
                            <span data-copy-notice-target="text"></span>
                            <a href="#" class="kd-btn kd-btn--ghost kd-btn--sm" data-copy-notice-target="open">L'ouvrir</a>
                        </p>
                    </form>
                {% endif %}
            </section>

            <section class="kd-card">
                <h3 class="kd-card__title">{{ ux_icon('lucide:layers') }} Nouveau plan</h3>
                <form method="post" action="{{ path('app_coach_plan_new', {id: athlete.id}) }}" class="kd-coachform">
                    <input type="hidden" name="_token" value="{{ csrf_token('coach_plan_new' ~ athlete.id) }}">
                    <div class="kd-field kd-coachform__field">
                        <label class="kd-label" for="coach_plan_title">Titre du plan</label>
                        <input class="kd-input" type="text" id="coach_plan_title" name="title"
                               placeholder="Prépa semi — 8 semaines" required>
                    </div>
                    <div class="kd-field kd-coachform__field kd-coachform__field--narrow">
                        <label class="kd-label" for="coach_plan_weeks">Semaines</label>
                        <input class="kd-input" type="number" id="coach_plan_weeks" name="durationWeeks"
                               value="4" min="1" max="52">
                    </div>
                    <button type="submit" class="kd-btn kd-btn--primary">
                        {{ ux_icon('lucide:plus') }} Créer et ouvrir
                    </button>
                </form>
            </section>

            {# Un plan de SA bibliothèque, copié chez l'athlète avec ses séances (#58).
               Pour lui donner le plan lui-même : « Donner ce plan à », dans l'éditeur. #}
            <section class="kd-card">
                <h3 class="kd-card__title">{{ ux_icon('lucide:copy') }} Un de mes plans</h3>
                {% if coachPlans is empty %}
                    <p class="kd-lead">Tu n'as pas encore de plan : compose-en un dans « Mes plans ».</p>
                {% else %}
                    <form method="post" action="{{ path('app_coach_plan_copy', {id: athlete.id}) }}" class="kd-coachform">
                        <input type="hidden" name="_token" value="{{ csrf_token('coach_plan_copy' ~ athlete.id) }}">
                        <div class="kd-field kd-coachform__field">
                            <label class="kd-label" for="coach_plan_copy">Plan à lui donner</label>
                            <select class="kd-input" id="coach_plan_copy" name="plan" required>
                                {% for plan in coachPlans %}
                                    <option value="{{ plan.id }}">{{ plan.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="kd-btn kd-btn--primary">
                            {{ ux_icon('lucide:plus') }} Ajouter à ses plans
                        </button>
                    </form>
                {% endif %}
            </section>
        </div>
    </section>

    {# ---------------------------- SA BIBLIOTHÈQUE --------------------------- #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Séances</p>
                <h2 class="kd-title kd-title--sm">Ses séances</h2>
            </div>
        </div>

        {% if workouts is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:clipboard-list') }}
                    <div>Aucune séance. Crée-lui une séance ci-dessus.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-card kd-section__block">
                <ul class="kd-coachitems">
                    {% for workout in workouts %}
                        <li class="kd-coachitem">
                            <a href="{{ path('app_workout_show', {id: workout.id}|merge(back_to('athlete', athlete.id))) }}" class="kd-coachitem__name">{{ workout.title }}</a>
                            <a href="{{ path('app_workout_edit', {id: workout.id}|merge(back_to('athlete', athlete.id))) }}" class="kd-btn kd-btn--ghost kd-btn--sm">
                                {{ ux_icon('lucide:square-pen') }} Modifier
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# Pose directe sur son calendrier : le contrôleur refuse toute séance
               qui ne lui appartient pas, ou qui est une copie privée de plan. #}
            <section class="kd-card kd-section__block">
                <h3 class="kd-card__title">{{ ux_icon('lucide:calendar-plus') }} Poser une séance sur son calendrier</h3>
                <form method="post" action="{{ path('app_coach_schedule', {id: athlete.id}) }}" class="kd-coachform">
                    <input type="hidden" name="_token" value="{{ csrf_token('coach_schedule' ~ athlete.id) }}">
                    <div class="kd-field kd-coachform__field">
                        <label class="kd-label" for="coach_schedule_workout">Séance</label>
                        <select class="kd-input" id="coach_schedule_workout" name="workoutId" required>
                            {% for workout in workouts %}
                                <option value="{{ workout.id }}">{{ workout.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="kd-field kd-coachform__field kd-coachform__field--narrow">
                        <label class="kd-label" for="coach_schedule_date">Date</label>
                        <input class="kd-input" type="date" id="coach_schedule_date" name="date"
                               value="{{ 'today'|date('Y-m-d') }}" required>
                    </div>
                    <button type="submit" class="kd-btn kd-btn--primary">
                        {{ ux_icon('lucide:calendar-plus') }} Poser
                    </button>
                </form>
            </section>
        {% endif %}
    </section>

    {# ------------------------------- SES PLANS ------------------------------ #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Plans</p>
                <h2 class="kd-title kd-title--sm">Ses plans multi-semaines</h2>
            </div>
        </div>

        {% if plans is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:layers') }}
                    <div>Aucun plan. Crée-lui un plan ci-dessus. Il pourra aussi le placer lui-même sur son calendrier.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-card kd-section__block">
                <ul class="kd-coachitems">
                    {% for plan in plans %}
                        <li class="kd-coachitem">
                            <a href="{{ path('app_plan_template_show', {id: plan.id}|merge(back_to('athlete', athlete.id))) }}" class="kd-coachitem__name">{{ plan.title }}</a>
                            <span class="kd-coachitem__meta">{{ plan.durationWeeks }} semaine{{ plan.durationWeeks > 1 ? 's' }}</span>
                            <a href="{{ path('app_plan_template_edit', {id: plan.id}|merge(back_to('athlete', athlete.id))) }}" class="kd-btn kd-btn--ghost kd-btn--sm">
                                {{ ux_icon('lucide:square-pen') }} Modifier
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# Pose idempotente : relancer ajoute les cases nouvelles (add-only), ne
               duplique ni ne redate rien. L'aperçu (#68) dit où tomberont les
               séances avant validation ; `?plan=` (bouton de la page du plan)
               présélectionne le plan et amène la section à l'écran. #}
            <section class="kd-card kd-section__block" id="placer-un-plan">
                <h3 class="kd-card__title">{{ ux_icon('lucide:calendar-range') }} Placer un plan dans son agenda</h3>
                <form method="post" action="{{ path('app_coach_instantiate', {id: athlete.id}) }}" class="kd-coachform"
                      data-controller="plan-preview"
                      data-plan-preview-plans-value="{{ planPlacement|json_encode }}"
                      data-action="change->plan-preview#update input->plan-preview#update">
                    <input type="hidden" name="_token" value="{{ csrf_token('coach_instantiate' ~ athlete.id) }}">
                    <div class="kd-field kd-coachform__field">
                        <label class="kd-label" for="coach_instantiate_plan">Plan</label>
                        <select class="kd-input" id="coach_instantiate_plan" name="planId" required
                                data-plan-preview-target="plan">
                            {% for plan in plans %}
                                <option value="{{ plan.id }}"{{ plan.id == preselectPlanId ? ' selected' }}>{{ plan.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="kd-field kd-coachform__field kd-coachform__field--narrow">
                        <label class="kd-label" for="coach_instantiate_start">Début</label>
                        <input class="kd-input" type="date" id="coach_instantiate_start" name="startDate"
                               value="{{ 'monday this week'|date('Y-m-d') }}" required
                               data-plan-preview-target="date">
                    </div>
                    <button type="submit" class="kd-btn kd-btn--primary">
                        {{ ux_icon('lucide:calendar-range') }} Placer dans l'agenda
                    </button>
                    {{ include('components/_plan_placement_preview.html.twig', {whose: 'son'}, with_context = false) }}
                </form>
            </section>
        {% endif %}
    </section>

    {# --------------------------- SON CALENDRIER ----------------------------- #}
    {# #77 (C-14) : la liste n'était que du texte. Chaque ligne ouvre désormais
       la séance datée (le titre) ou sa semaine dans l'agenda de l'athlète (la
       date), où se trouvent les gestes du calendrier : statut, déplacer,
       retirer. Les deux posent un contexte de retour, sans quoi le clic suivant
       renvoyait le coach à SON calendrier. #}
    <section class="kd-section" id="agenda">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Calendrier</p>
                <h2 class="kd-title kd-title--sm">Ses 8 prochaines semaines</h2>
            </div>
            <a href="{{ path('app_coach_athlete_calendar', {id: athlete.id}) }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:calendar-range') }} Son agenda
            </a>
        </div>

        {% if upcoming is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:calendar-off') }}
                    <div>Rien de prévu dans les 8 prochaines semaines.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-card kd-section__block">
                <ul class="kd-coachitems">
                    {% for scheduled in upcoming %}
                        <li class="kd-coachitem">
                            <a class="kd-coachitem__date"
                               href="{{ path('app_coach_athlete_calendar', {id: athlete.id, date: scheduled.scheduledDate|date('Y-m-d')}) }}"
                               title="Voir sa semaine dans l'agenda">{{ scheduled.scheduledDate|date('d/m') }}</a>
                            <a class="kd-coachitem__name"
                               href="{{ path('app_scheduled_workout_show', {id: scheduled.id}|merge(back_to('athlete', athlete.id))) }}">{{ scheduled.displayTitle }}</a>
                            <span class="kd-badge kd-badge--{{ scheduled.status.value }}">{{ scheduled.status.label }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </section>

    {# ------------------------- SES DERNIÈRES SÉANCES ------------------------- #}
    {# #76 : tout ce qui est échu sur ses quatre dernières semaines, consigné ou
       non (`RecentSessions`). Le journal ne listait que le réalisé consigné :
       une séance manquée n'apparaissait nulle part, une séance cochée « faite »
       sans détail non plus, et « aucune séance consignée » côtoyait « 1 faite »
       (C-10, C-11). Une séance consignée garde sa ligne de journal, chiffres
       compris ; les autres disent leur statut, et « sans détail » quand il n'y
       a rien derrière.

       **Lecture stricte** : chaque ligne mène à la page de séance datée, dont le
       bloc de suppression du réalisé est gardé par l'attribut LOG, réservé au
       propriétaire. Personne ne déclare à la place de quelqu'un d'autre ce
       qu'il a soulevé.

       Chaque ligne pose son contexte de retour (`athlete-<id>`) : sans lui, le
       retour de la séance datée renvoyait le coach à SON calendrier — un lien ne
       change pas de sujet en silence.

       Le bloc-notes privé de l'athlète (`Workout.notes`) n'apparaît ni ici ni
       là-bas : il ne se rend que dans les éditeurs, et pour son seul propriétaire. #}
    <section class="kd-section" id="dernieres-seances">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Suivi</p>
                <h2 class="kd-title kd-title--sm">Ses dernières séances</h2>
                <p class="kd-lead">Ses {{ recentWeeks }} dernières semaines : faites, manquées ou pas encore cochées. Lecture seule : seul l'athlète saisit ses charges.</p>
            </div>
            {% if loggedTotal > 0 %}
                <a href="{{ path('app_coach_athlete_log', {id: athlete.id}) }}" class="kd-btn kd-btn--ghost">
                    {{ ux_icon('lucide:history') }} Son journal ({{ loggedTotal }})
                </a>
            {% endif %}
        </div>

        {# Ses séances de force faites sans réalisé, depuis le début : elles
           comptent « faites » sur ses statistiques et ne portent aucun chiffre.
           La phrase dit où ces chiffres se saisissent (C-11, #63). #}
        {% if unloggedStrength > 0 %}
            {{ include('components/_log_in_app.html.twig', {
                count: unloggedStrength, third: true
            }, with_context = false) }}
        {% endif %}

        {% if recent is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:history') }}
                    <div>Aucune séance datée sur ses {{ recentWeeks }} dernières semaines.{% if loggedTotal > 0 %} Les plus anciennes se lisent dans son journal.{% endif %}</div>
                    {% if unloggedStrength == 0 %}
                        {{ include('components/_log_in_app.html.twig', {third: true}, with_context = false) }}
                    {% endif %}
                </div>
            </div>
        {% else %}
            {# La carte est le conteneur, la liste est dedans — comme partout
               ailleurs (`kd-card` > `kd-coachitems`). Les cumuler sur le même
               `<ul>` fait perdre à la carte son padding : le reset de liste est
               déclaré plus loin dans la feuille et l'emporte. #}
            <div class="kd-card kd-section__block">
                <ul class="kd-loglist">
                    {% for entry in recent %}
                        {{ include('components/_log_entry.html.twig', {
                            entry: entry, back: back_to('athlete', athlete.id), statusAlways: true
                        }) }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </section>

    {# --------------------- SON PROFIL (lecture seule) ----------------------- #}
    {# Mêmes fragments que la page profil de l'athlète : sans ses 1RM, ses records
       et ses zones cardio, on ne peut pas programmer sérieusement. `own: false` :
       la fiche lui appartient, le coach la lit (aucun lien d'édition). #}
    {{ include('profile/_stats.html.twig', {stats: stats, own: false}) }}
    {{ include('profile/_athlete_sheet.html.twig', {stats: stats, hrZones: hrZones, own: false, subject: athlete}) }}
{% endblock %}
