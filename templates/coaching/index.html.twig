{% extends 'base.html.twig' %}

{#
    Page unique de la relation coach ↔ athlète : les deux sens vivent ici.
    Il n'y a plus d'« espace coach » séparé — /coach ne porte plus que la fiche
    de travail d'un athlète donné (app_coach_athlete).

    Deux leviers UX portent la fusion :
      - les demandes reçues sont mutualisées en tête, quel que soit le sens ;
        une demande envoyée, elle, se range dans la section de la relation
        qu'elle propose (#79) ;
      - l'ordre des sections suit le rôle : un ROLE_COACH ouvre la page pour ses
        athlètes, un athlète pour ses coachs. D'où les macros ci-dessous, appelées
        dans un ordre ou dans l'autre.
#}
{% macro coachesSection(coaches, pending, me) %}
    <section class="kd-section" id="coachs">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Qui t'entraîne</p>
                <h2 class="kd-title kd-title--sm">
                    {{ coaches is empty ? 'Mes coachs' : coaches|length ~ ' coach' ~ (coaches|length > 1 ? 's') }}
                </h2>
            </div>
        </div>

        {# Les demandes envoyées à un coach se rangent ici, sous les relations
           actives (#79) : c'est là qu'on les cherche. #}
        {% if coaches is empty and pending is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:user-plus') }}
                    <div>Personne ne t'entraîne pour l'instant. Demande à ton coach son email Kadens et envoie-lui une demande ci-dessous.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-coachlist kd-section__block">
                {% for relation in coaches|merge(pending) %}
                    {{ include('components/_coaching_card.html.twig', {relation: relation, me: me}) }}
                {% endfor %}
            </div>
        {% endif %}

        {# La cible doit avoir le rôle coach (contrôlé serveur). `role=athlete`
           permet à un ROLE_COACH d'être lui-même coaché : sans ce champ, le
           contrôleur le placerait du côté coach de la relation. #}
        <section class="kd-card kd-section__block">
            <h3 class="kd-card__title">{{ ux_icon('lucide:mail') }} Demander à être coaché</h3>
            <p class="kd-coachform__hint">Saisis l'email exact du compte Kadens de ton coach. Il recevra une demande à accepter.</p>
            {# Demander, c'est déjà consentir : la liste des droits (#66) se lit
               avant d'envoyer, comme avant d'accepter. #}
            <details class="kd-coachcard__rights kd-coachform__rights">
                <summary>{{ ux_icon('lucide:chevron-down') }} Ce que ton coach pourra faire</summary>
                {{ include('components/_coaching_rights.html.twig', {coach: null, title: false}) }}
            </details>
            <form method="post" action="{{ path('app_coaching_request') }}" class="kd-coachform">
                <input type="hidden" name="_token" value="{{ csrf_token('coaching_request') }}">
                <input type="hidden" name="role" value="athlete">
                <div class="kd-field kd-coachform__field">
                    <label class="kd-label" for="coaching_request_email">Email du coach</label>
                    {# Texte libre et non `type=email` (#79) : un pseudo saisi ici
                       reçoit l'explication du site, pas la bulle du navigateur. #}
                    <div class="kd-inputgroup">
                        {{ ux_icon('lucide:at-sign') }}
                        <input class="kd-input" type="text" inputmode="email" autocomplete="off"
                               autocapitalize="none" spellcheck="false"
                               id="coaching_request_email" name="email"
                               placeholder="coach@exemple.fr" required
                               aria-describedby="coaching_request_email_help">
                    </div>
                    <p class="kd-help" id="coaching_request_email_help">L'adresse email de son compte Kadens. Son pseudo ne suffit pas.</p>
                </div>
                <button type="submit" class="kd-btn kd-btn--primary">
                    {{ ux_icon('lucide:send') }} Envoyer la demande
                </button>
            </form>
        </section>
    </section>
{% endmacro %}

{% macro athletesSection(athletes, pending, former, me) %}
    {# `linkAthlete` ouvre la fiche de travail sous /coach, protégée par
       ROLE_COACH : on ne propose le lien qu'à un coach, sinon un ex-coach
       (rôle retiré, relations résiduelles) cliquerait vers un 403. #}
    <section class="kd-section" id="athletes">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Qui tu entraînes</p>
                <h2 class="kd-title kd-title--sm">
                    {{ athletes is empty ? 'Mes athlètes' : athletes|length ~ ' athlète' ~ (athletes|length > 1 ? 's') ~ ' suivi' ~ (athletes|length > 1 ? 's') }}
                </h2>
            </div>
        </div>

        {# Les invitations envoyées se rangent ici, badge « En attente » (#79).
           Rangées tout en bas de page, le coach croyait l'envoi perdu pendant
           que cette section lui disait « aucun athlète ». #}
        {% if athletes is empty and pending is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:users') }}
                    <div>Aucun athlète pour l'instant. Invite quelqu'un par son email Kadens ci-dessous : il devra accepter avant que tu puisses programmer pour lui.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-coachlist kd-section__block">
                {% for relation in athletes|merge(pending) %}
                    {{ include('components/_coaching_card.html.twig', {relation: relation, me: me, linkAthlete: me.isCoach}) }}
                {% endfor %}
            </div>
        {% endif %}

        {# Anciens athlètes (#81) : sans eux, « Terminer » ne laissait aucune
           trace côté coach. Un nom et des dates, rien de plus : la carte n'ouvre
           aucune fiche, le contenu reste à l'athlète et ne lui est plus ouvert. #}
        {% if former is not empty %}
            <div class="kd-section__block" id="anciens-athletes">
                <h3 class="kd-card__title">{{ ux_icon('lucide:history') }} Anciens athlètes</h3>
                <p class="kd-coachform__hint">Tu ne les suis plus. Leur contenu leur reste et tu n'y as plus accès. Une nouvelle invitation, s'ils l'acceptent, renoue la relation.</p>
                <div class="kd-coachlist">
                    {% for relation in former %}
                        {{ include('components/_coaching_card.html.twig', {relation: relation, me: me}) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if me.isCoach %}
            {# Le mini-guide coach (#72), ouvert tant qu'il n'a personne à suivre :
               c'est là qu'il en a besoin. Même texte que sur /aide. #}
            {% import 'help/_topics.html.twig' as help %}
            <details class="kd-card kd-section__block kd-coachguide"{{ athletes is empty ? ' open' }}>
                <summary class="kd-coachguide__summary">{{ ux_icon('lucide:circle-help') }} Guide du coach : inviter, programmer, ce que voit l'athlète, fin de relation</summary>
                <div class="kd-help__body">{{ help.coach_guide() }}</div>
            </details>

            <section class="kd-card kd-section__block">
                <h3 class="kd-card__title">{{ ux_icon('lucide:user-plus') }} Inviter un athlète</h3>
                <p class="kd-coachform__hint">L'athlète doit déjà avoir un compte Kadens. Il recevra une demande à accepter avant que tu aies accès à son contenu.</p>
                <form method="post" action="{{ path('app_coaching_request') }}" class="kd-coachform">
                    <input type="hidden" name="_token" value="{{ csrf_token('coaching_request') }}">
                    <div class="kd-field kd-coachform__field">
                        <label class="kd-label" for="coach_invite_email">Email de l'athlète</label>
                        <div class="kd-inputgroup">
                            {{ ux_icon('lucide:at-sign') }}
                            <input class="kd-input" type="text" inputmode="email" autocomplete="off"
                                   autocapitalize="none" spellcheck="false"
                                   id="coach_invite_email" name="email"
                                   placeholder="athlete@exemple.fr" required
                                   aria-describedby="coach_invite_email_help">
                        </div>
                        <p class="kd-help" id="coach_invite_email_help">Son adresse email, celle de son compte Kadens. Son pseudo ne suffit pas.</p>
                    </div>
                    <button type="submit" class="kd-btn kd-btn--primary">
                        {{ ux_icon('lucide:send') }} Envoyer l'invitation
                    </button>
                </form>
            </section>
        {% endif %}
    </section>
{% endmacro %}

{% block title %}Coaching — Kadens{% endblock %}

{% block body %}
    {% import _self as sections %}

    {% set me = app.user %}

    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow kd-eyebrow--accent">Coaching</p>
            <h1 class="kd-title">Qui t'entraîne, qui tu entraînes</h1>
            <p class="kd-lead">Un coach accepté suit les statistiques et l'historique de son athlète, crée et modifie ses séances, ses plans et son agenda. Ses notes privées restent privées. Le contenu appartient toujours à l'athlète : il le garde même si la relation se termine.</p>
        </div>
    </div>

    {# --------------------------- DEMANDES REÇUES ---------------------------- #}
    {% if received is not empty %}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">À traiter</p>
                    <h2 class="kd-title kd-title--sm">Demandes reçues</h2>
                </div>
            </div>
            <div class="kd-coachlist kd-section__block">
                {% for relation in received %}
                    {{ include('components/_coaching_card.html.twig', {relation: relation, me: me}) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ------------------- RELATIONS, ordonnées selon le rôle ------------------ #}
    {% if me.isCoach %}
        {{ sections.athletesSection(athletes, sentAsCoach, formerAthletes, me) }}
        {{ sections.coachesSection(coaches, sentAsAthlete, me) }}
    {% else %}
        {{ sections.coachesSection(coaches, sentAsAthlete, me) }}
        {# Un non-coach n'a normalement pas d'athlète : la section n'apparaît que
           s'il reste des relations d'un rôle retiré depuis. #}
        {% if athletes is not empty or sentAsCoach is not empty or formerAthletes is not empty %}
            {{ sections.athletesSection(athletes, sentAsCoach, formerAthletes, me) }}
        {% endif %}
    {% endif %}
{% endblock %}
