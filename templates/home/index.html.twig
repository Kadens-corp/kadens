{% extends 'base.html.twig' %}
{% import 'components/_activity.html.twig' as activity %}

{# Accueil : « où j'en suis ». Sur un agenda vide, le démarrage en trois
   étapes ; sinon la prochaine séance. Puis l'espace coach, le prochain
   objectif en aplat encre, le mois en deux cartes (observance, répartition) et
   les raccourcis vers les pages de lecture. La fiche de l'athlète est sur
   /profile. #}

{% block title %}Accueil — Kadens{% endblock %}

{% block body %}
    {% set u = app.user %}
    {% set dayNames = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'} %}
    {% set monthNames = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
    {% set monthName = monthNames[today|date('n')] %}

    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    <div class="kd-home">
        <div class="kd-home__head">
            <h1 class="kd-home__title">Salut {{ u.displayName }}</h1>
            <p class="kd-eyebrow">{{ dayNames[today|date('N')] }} {{ today|date('j') }} {{ monthName }} · S{{ today|date('W') }}</p>
        </div>

        {# ============================== COACHING ============================ #}
        {% for relation in coachingReceived %}
            {% set other = relation.otherParty(u) %}
            <div class="kd-home__coach">
                {{ ux_icon('lucide:users') }}
                <p class="kd-home__coachtext">
                    <strong>{{ other ? other.displayName : 'Quelqu\'un' }}</strong>
                    {{ relation.coach == u ? 'te demande de l\'entraîner' : 'propose de t\'entraîner' }}
                </p>
                {# L'athlète sait à quoi il donne accès avant d'accepter (#66).
                   Le coach qui reçoit une demande n'ouvre rien : pas de liste. #}
                {% if relation.athlete and relation.athlete.id == u.id %}
                    {{ include('components/_coaching_rights.html.twig', {coach: other}) }}
                {% endif %}
                <div class="kd-home__coachacts">
                    <form method="post" action="{{ path('app_coaching_respond', {id: relation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('coaching_respond' ~ relation.id) }}">
                        <input type="hidden" name="decision" value="accept">
                        <button type="submit" class="kd-btn kd-btn--primary kd-btn--sm">Accepter</button>
                    </form>
                    <form method="post" action="{{ path('app_coaching_respond', {id: relation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('coaching_respond' ~ relation.id) }}">
                        <input type="hidden" name="decision" value="decline">
                        <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm kd-home__decline">Refuser</button>
                    </form>
                </div>
            </div>
        {% endfor %}

        {# ============================== DÉMARRAGE =========================== #}
        {# Un compte qui n'a rien dans son agenda ne sait pas par où commencer
           (A-01). Les étapes se cochent sur l'état réel des données, la
           première non faite est mise en avant. Le bloc disparaît dès qu'une
           séance est dans l'agenda (cf. HomeController::onboarding). #}
        {% if onboarding %}
            {% set placeTarget = onboarding.filledPlan
                ? path('app_calendar_index', {place: onboarding.filledPlan.id})
                : path('app_calendar_index') %}
            {% set steps = [
                { done: onboarding.workout, icon: 'lucide:dumbbell', title: 'Crée une séance',
                  text: 'Choisis tes exercices et règle séries, charges ou distances.',
                  href: path('app_workout_index') },
                { done: onboarding.plan, icon: 'lucide:layers', title: 'Assemble-la dans un plan',
                  text: 'Répartis tes séances sur les jours de la semaine, pour plusieurs semaines.',
                  href: path('app_plan_template_index') },
                { done: false, icon: 'lucide:calendar-plus', title: 'Place le plan dans ton agenda',
                  text: 'Choisis une date de départ : chaque séance prend sa date.',
                  href: placeTarget },
            ] %}
            {% set current = null %}
            {% for step in steps %}{% if current is null and not step.done %}{% set current = loop.index %}{% endif %}{% endfor %}
            <section class="kd-home__start" aria-labelledby="home-start-title">
                <div class="kd-home__starthead">
                    <h2 id="home-start-title" class="kd-home__starttitle">Par où commencer</h2>
                    <p class="kd-home__startlead">Kadens sert à préparer tes entraînements : tu composes tes séances, tu les assembles en plans, puis tu les suis dans ton agenda.</p>
                </div>
                <ol class="kd-home__steps">
                    {% for step in steps %}
                        <li class="kd-home__step{{ step.done ? ' kd-home__step--done' }}{{ loop.index == current ? ' kd-home__step--current' }}">
                            <a href="{{ step.href }}" class="kd-home__steplink">
                                <span class="kd-home__stepmark" aria-hidden="true">
                                    {{ ux_icon(step.done ? 'lucide:circle-check' : step.icon) }}
                                </span>
                                <span class="kd-home__stepbody">
                                    <span class="kd-eyebrow kd-home__stepnum">Étape {{ loop.index }}{{ step.done ? ' · faite' }}</span>
                                    <span class="kd-home__steptitle">{{ step.title }}</span>
                                    <span class="kd-home__steptext">{{ step.text }}</span>
                                </span>
                                <span class="kd-home__linkarrow">{{ ux_icon('lucide:arrow-right') }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            </section>
        {% else %}
            {# ========================= PROCHAINE SÉANCE ===================== #}
            {# La séance qu'il reste à faire, le jour qui en porte une : toutes
               celles du jour s'il y en a plusieurs (séance double). Chaque ligne
               ouvre la séance datée. #}
            {% set first = nextSessions|first %}
            <section class="kd-home__next" aria-labelledby="home-next-title">
                {% if first %}
                    {% set day = first.scheduledDate %}
                    {% set gap = day.diff(today).days %}
                    <p id="home-next-title" class="kd-eyebrow kd-home__nexteyebrow">
                        {%- if gap == 0 -%}
                            Aujourd'hui
                        {%- else -%}
                            Ta prochaine séance · {{ gap == 1 ? 'demain' : dayNames[day|date('N')]|lower ~ ' ' ~ day|date('j') ~ ' ' ~ monthNames[day|date('n')] }}
                        {%- endif -%}
                    </p>
                    <ul class="kd-home__nextlist">
                        {% for session in nextSessions %}
                            <li>
                                <a href="{{ path('app_scheduled_workout_show', {id: session.id}) }}" class="kd-home__nextitem">
                                    <span class="kd-home__nexttitle">{{ session.displayTitle }}</span>
                                    {% if session.sourcePlanTemplate %}
                                        <span class="kd-home__nextplan">{{ ux_icon('lucide:layers') }} {{ session.sourcePlanTemplate.title }}</span>
                                    {% endif %}
                                    <span class="kd-home__linkarrow">{{ ux_icon('lucide:arrow-right') }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p id="home-next-title" class="kd-eyebrow kd-home__nexteyebrow">Ta prochaine séance</p>
                    <a href="{{ path('app_calendar_index') }}" class="kd-home__nextitem">
                        <span class="kd-home__nexttitle kd-home__nexttitle--empty">Rien de prévu pour l'instant. Ouvre ton agenda pour placer ta prochaine séance.</span>
                        <span class="kd-home__linkarrow">{{ ux_icon('lucide:arrow-right') }}</span>
                    </a>
                {% endif %}
            </section>
        {% endif %}

        {# ============================= ESPACE COACH ========================= #}
        {# Seul le menu avatar menait à /coaching (C-01) : la tuile met l'espace
           du coach à portée dès l'arrivée. #}
        {% if athleteCount is not null %}
            <a href="{{ path('app_coaching_index') }}" class="kd-home__card kd-home__athletes">
                {{ ux_icon('lucide:users') }}
                <span class="kd-home__athletesbody">
                    <span class="kd-home__linklabel">Mes athlètes</span>
                    <span class="kd-home__athletescount">
                        {{- athleteCount == 0 ? 'Aucun athlète suivi pour l\'instant. Invite ton premier athlète.' : athleteCount ~ ' athlète' ~ (athleteCount > 1 ? 's') ~ ' suivi' ~ (athleteCount > 1 ? 's') -}}
                    </span>
                </span>
                <span class="kd-home__linkarrow">{{ ux_icon('lucide:arrow-right') }}</span>
            </a>
        {% endif %}

        {# ========================== PROCHAIN OBJECTIF ======================= #}
        {% set goal = goals|first %}
        {% if goal %}
            {% set days = goal.daysUntil %}
            {% set next = goals|length > 1 ? goals[1] : null %}
            <a href="{{ path('app_goal_show', {id: goal.id}) }}" class="kd-home__goal">
                <div class="kd-home__goalmain">
                    <div class="kd-home__goalbody">
                        <p class="kd-eyebrow kd-home__goaleyebrow">Prochain objectif · {{ goal.targetDate|date('d/m/Y') }}</p>
                        <h2 class="kd-home__goaltitle">{{ goal.title }}</h2>
                        <div class="kd-home__goalmeta">
                            {% if goal.activity %}{{ activity.badge(goal.activity) }}{% endif %}
                            <span class="kd-home__goalprio" title="{{ goal.priority.label }}">Priorité {{ goal.priority.shortLabel }}</span>
                            {% if goal.targetValue %}
                                <span class="kd-home__goaltarget">{{ ux_icon('lucide:target') }} {{ goal.targetValue }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <span class="kd-home__goalcount">{{ days == 0 ? 'Jour J' : 'J-' ~ days }}</span>
                </div>
                {% if next %}
                    <div class="kd-home__goalnext">
                        <span class="kd-eyebrow kd-home__goalnextlabel">Ensuite</span>
                        <span class="kd-home__goalnexttitle">{{ next.title }}</span>
                        <span class="kd-home__goalnextcount">{{ next.daysUntil == 0 ? 'Jour J' : 'J-' ~ next.daysUntil }}</span>
                    </div>
                {% endif %}
            </a>
        {% elseif not onboarding %}
            {# Pas d'objectif : une invitation discrète, mais pas sur un compte
               qui démarre, où elle doublerait les étapes (A-01). #}
            <div class="kd-card">
                <div class="kd-empty">
                    {{ ux_icon('lucide:target') }}
                    <div>Aucune échéance en vue. <a href="{{ path('app_goal_new') }}">Fixe-toi un objectif</a> pour donner un cap à tes plans.</div>
                </div>
            </div>
        {% endif %}

        {# =============================== LE MOIS ============================ #}
        {# Les deux cartes ouvrent les statistiques sur le mois courant : ce sont
           les mêmes chiffres (TrainingStats, même fenêtre). Chaque séance faite
           compte UNE fois, sous sa nature (SessionNature) : le total vaut le
           nombre de séances faites de l'observance (#62). #}
        {% set monthStats = path('app_profile_stats', {range: month.period.queryValue}) %}
        {% set acts = month.activityCounts %}
        {% set actTotal = acts|reduce((sum, r) => sum + r.sessions, 0) %}
        {% set actMax = acts|reduce((m, r) => max(m, r.sessions), 0) %}
        <div class="kd-grid kd-grid--2">
            <a href="{{ monthStats }}" class="kd-home__card">
                <p class="kd-eyebrow">{{ monthName|capitalize }} · observance</p>
                {{ include('components/_status_stats.html.twig', {stats: month.adherence, hero: true}) }}
            </a>
            <a href="{{ monthStats }}" class="kd-home__card">
                <p class="kd-eyebrow">{{ monthName|capitalize }} · par activité{{ actTotal > 0 ? ' · ' ~ actTotal ~ ' séance' ~ (actTotal > 1 ? 's') ~ ' faite' ~ (actTotal > 1 ? 's') }}</p>
                {% if acts is empty %}
                    <p class="kd-observance__empty">{{ ux_icon('lucide:activity') }} Aucune séance faite ce mois-ci.</p>
                {% else %}
                    <ul class="kd-home__acts">
                        {% for row in acts %}
                            <li class="kd-home__act{{ row.activity ? ' kd-act--' ~ activity.modifier(row.activity) }}">
                                <span class="kd-home__actname">{{ ux_icon(activity.icon(row.activity)|trim) }} {{ activity.label(row.activity) }}</span>
                                <span class="kd-home__acttrack"><span class="kd-home__actfill" style="width:{{ (row.sessions / actMax * 100)|round }}%"></span></span>
                                <span class="kd-home__actcount">{{ row.sessions }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </a>
        </div>

        {# ============================== RACCOURCIS ========================== #}
        {% set shortcuts = [
            { label: 'Mon profil',   icon: 'lucide:user',           path: 'app_profile' },
            { label: 'Journal',      icon: 'lucide:clipboard-list', path: 'app_profile_log' },
            { label: 'Historique',   icon: 'lucide:history',        path: 'app_profile_history' },
            { label: 'Statistiques', icon: 'lucide:chart-column',   path: 'app_profile_stats' },
            { label: 'Exercices',    icon: 'lucide:dumbbell',       path: 'app_exercise_index' },
            { label: 'Objectifs',    icon: 'lucide:target',         path: 'app_goal_index' },
        ] %}
        <nav class="kd-home__index" aria-label="Raccourcis">
            {% for s in shortcuts %}
                <a href="{{ path(s.path) }}" class="kd-home__link">
                    {{ ux_icon(s.icon) }}
                    <span class="kd-home__linklabel">{{ s.label }}</span>
                    <span class="kd-home__linkarrow">{{ ux_icon('lucide:arrow-right') }}</span>
                </a>
            {% endfor %}
        </nav>
    </div>
{% endblock %}
