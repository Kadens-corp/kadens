{% extends 'base.html.twig' %}
{% import 'components/_activity.html.twig' as activity %}

{% block title %}{{ goal.title }} — Objectif{% endblock %}

{% block body %}
    {# `mine` : la fiche est ouverte par son propriétaire, ou par son coach
       (GoalVoter accorde VIEW/EDIT aux deux). Tout ce que la page fait — poser un
       plan, rattacher — vise le propriétaire, jamais le lecteur ; ces libellés le
       disent. Comparaison par `id` : `owner` peut être un proxy Doctrine. #}
    {% set mine = app.user is not null and goal.owner is not null and goal.owner.id == app.user.id %}

    <a href="{{ mine ? path('app_goal_index') : path('app_coach_athlete', {id: goal.owner.id}) }}" class="kd-backlink">
        {{ ux_icon('lucide:arrow-left') }} {{ mine ? 'Objectifs' : goal.owner.displayName }}
    </a>

    {% set days = goal.daysUntil %}
    <header class="kd-goalhero">
        <div class="kd-goalhero__count">
            {% if days == 0 %}
                <span class="kd-goalhero__num kd-goalhero__num--now">Jour J</span>
            {% elseif days > 0 %}
                <span class="kd-goalhero__num">J-{{ days }}</span>
                <span class="kd-goalhero__unit">{{ days > 1 ? 'jours' : 'jour' }}</span>
            {% else %}
                <span class="kd-goalhero__num kd-goalhero__num--past">J+{{ -days }}</span>
                <span class="kd-goalhero__unit">écoulé{{ -days > 1 ? 's' }}</span>
            {% endif %}
        </div>
        <div class="kd-goalhero__main">
            <div class="kd-goalhero__top">
                <span class="kd-prio kd-prio--{{ goal.priority.value }}" title="Priorité : {{ goal.priority.label|lower }}">{{ goal.priority.shortLabel }}</span>
                <h1 class="kd-title">{{ goal.title }}</h1>
            </div>
            <ul class="kd-vitals">
                <li class="kd-vitals__item">{{ ux_icon('lucide:calendar-days') }} {{ goal.targetDate|date('d/m/Y') }}</li>
                {% if goal.activity %}<li class="kd-vitals__item">{{ goal.activity.label }}</li>{% endif %}
                {% if goal.targetValue %}<li class="kd-vitals__item">{{ ux_icon('lucide:target') }} {{ goal.targetValue }}</li>{% endif %}
                <li class="kd-vitals__item">Priorité : {{ goal.priority.label|lower }}</li>
            </ul>
        </div>
        <div class="kd-goalhero__actions">
            <a href="{{ path('app_goal_edit', {id: goal.id}) }}" class="kd-btn kd-btn--secondary">
                {{ ux_icon('lucide:square-pen') }} Éditer
            </a>
            <form method="post" action="{{ path('app_goal_delete', {id: goal.id}) }}"
                  onsubmit="return confirm('Supprimer cet objectif ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_goal' ~ goal.id) }}">
                <button type="submit" class="kd-btn kd-btn--danger">{{ ux_icon('lucide:trash-2') }} Supprimer</button>
            </form>
        </div>
    </header>

    {% if goal.description %}
        <section class="kd-card kd-section__block">
            <p class="kd-profile__bio">{{ goal.description|nl2br }}</p>
        </section>
    {% endif %}

    {# -------------------------------- RÉCIT -------------------------------- #}
    {# #42 — l'objectif se lit comme un article : présentation, récit, résultat,
       puis la préparation en dessous. Le récit s'écrit sur sa propre page
       (`app_goal_story`) ; ici, il se lit tel que le verra un lecteur du lien. #}
    <section class="kd-section kd-goalstory" id="recit">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Récit</p>
                <h2 class="kd-title kd-title--sm">L'histoire de cet objectif</h2>
            </div>
            <a href="{{ path('app_goal_story', {id: goal.id}) }}" class="kd-btn kd-btn--secondary kd-btn--sm">
                {{ ux_icon('lucide:square-pen') }} {{ story is empty ? 'Écrire le récit' : 'Éditer le récit' }}
            </a>
        </div>

        {% if story is empty %}
            <div class="kd-card">
                <div class="kd-empty">
                    {{ ux_icon('lucide:pilcrow') }}
                    <div>Pas encore de récit. Raconte la prépa et le jour J : du texte, des photos, tes sorties et tes séances faites.</div>
                </div>
            </div>
        {% else %}
            <article class="kd-card kd-goalstory__body">
                {{ include('components/_goal_story.html.twig', {goal: goal, story: story, public: false}, with_context = false) }}
            </article>
        {% endif %}

        {# Publier est un geste de propriétaire (GoalStoryController::publish) :
           le coach ne voit pas ce bandeau. #}
        {% if mine %}
            {{ include('goal/_share.html.twig', {goal: goal}, with_context = false) }}
        {% endif %}
    </section>

    {# ------------------------------ RÉSULTAT ------------------------------- #}
    {% if goal.outcome %}
        <section class="kd-card kd-section__block">
            <h2 class="kd-card__title kd-profile__grouphead">{{ ux_icon(goal.outcome.icon) }} Résultat</h2>
            <p><span class="kd-badge kd-badge--{{ goal.outcome.modifier }}">{{ goal.outcome.label }}</span></p>
            {% if goal.resultNote %}<p class="kd-profile__bio">{{ goal.resultNote|nl2br }}</p>{% endif %}
        </section>
    {% elseif goal.isPast %}
        <section class="kd-card kd-section__block">
            <div class="kd-empty">
                {{ ux_icon('lucide:flag') }}
                <div>L'échéance est passée. <a href="{{ path('app_goal_edit', {id: goal.id}) }}">Renseigne le résultat</a> pour boucler.</div>
            </div>
        </section>
    {% endif %}

    {# --------------------------- LA PRÉPARATION ---------------------------- #}
    {# Les outils sous l'article : ce qui ne se raconte pas, et qui n'apparaît
       jamais sur la page publique. #}
    <div class="kd-pagehead kd-pagehead--sub kd-goalprep">
        <div>
            <p class="kd-eyebrow kd-eyebrow--accent">Préparation</p>
            <h2 class="kd-title kd-title--sm">Plans et séances</h2>
        </div>
    </div>

    {# ------------------------ PLANS DE PRÉPARATION ------------------------- #}
    {# Le pendant du bandeau d'objectifs de l'éditeur de plan : le lien se pose et
       se défait des deux côtés. Associer documente l'intention (« ces plans
       préparent cette échéance ») sans toucher à l'agenda ; poser les séances au
       calendrier, c'est le bloc suivant. Les deux gestes se ressemblent : l'un
       est un simple lien, l'autre crée des séances datées, et l'audit (A-34) a
       failli les confondre. Les libellés le disent donc en toutes lettres.
       Plusieurs plans par objectif : une prépa se découpe souvent en blocs
       (base puis spécifique). #}
    <section class="kd-card kd-section__block">
        <h2 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:layers') }} Plans de préparation</h2>
        <p class="kd-lead" style="margin-top:0;">
            Associer un plan note qu'il prépare cette échéance. L'agenda ne bouge pas.
        </p>

        {% if goal.planTemplates is empty %}
            <div class="kd-empty">
                {{ ux_icon('lucide:layers') }}
                <div>Aucun plan associé à cette échéance.</div>
            </div>
        {% else %}
            <ul class="kd-goalplans">
                {% for plan in goal.planTemplates %}
                    <li class="kd-goalplan">
                        <a href="{{ path('app_plan_template_show', {id: plan.id}) }}" class="kd-goalplan__name">{{ plan.title }}</a>
                        {% if plan.durationWeeks %}
                            <span class="kd-tag">{{ plan.durationWeeks }} sem.</span>
                        {% endif %}
                        <div class="kd-goalplan__actions">
                            <a href="{{ path('app_plan_template_edit', {id: plan.id}) }}" class="kd-btn kd-btn--ghost kd-btn--sm">
                                {{ ux_icon('lucide:square-pen') }} Éditer
                            </a>
                            <form method="post" action="{{ path('app_goal_plans', {id: goal.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('goal_plans' ~ goal.id) }}">
                                <input type="hidden" name="action" value="detach">
                                <input type="hidden" name="planTemplate" value="{{ plan.id }}">
                                <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm"
                                        aria-label="Détacher « {{ plan.title }} » de cet objectif">
                                    {{ ux_icon('lucide:unlink') }} Détacher
                                </button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="kd-goalplans__tools">
            {% if attachablePlans is not empty %}
                <form method="post" action="{{ path('app_goal_plans', {id: goal.id}) }}" class="kd-goalplans__attach">
                    <input type="hidden" name="_token" value="{{ csrf_token('goal_plans' ~ goal.id) }}">
                    <input type="hidden" name="action" value="attach">
                    <select name="planTemplate" class="kd-input kd-select" aria-label="Plan à associer" required>
                        <option value="">Choisir un plan à associer…</option>
                        {% for plan in attachablePlans %}
                            <option value="{{ plan.id }}">{{ plan.title }}{% if plan.durationWeeks %} ({{ plan.durationWeeks }} sem.){% endif %}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="kd-btn kd-btn--secondary kd-btn--sm">
                        {{ ux_icon('lucide:link-2') }} Associer ce plan (sans toucher à l'agenda)
                    </button>
                </form>
            {% endif %}
            {{ include('components/_create_button.html.twig', {
                route: 'app_goal_plan_new', token: 'goal_plan_new' ~ goal.id,
                params: {id: goal.id}, label: 'Nouveau plan pour cet objectif',
                class: 'kd-btn kd-btn--secondary kd-btn--sm',
            }) }}
        </div>
    </section>

    {# ------------------- PLANIFIER POUR FINIR LE JOUR J ---------------------- #}
    {# Le geste lourd : il crée des séances datées. Bouton secondaire, et une
       phrase qui dit ce qu'il fait, pour qu'on ne le prenne pas pour un simple
       lien (A-34). Il associe le plan au passage : inutile d'associer avant. #}
    {% if not goal.isPast %}
        <section class="kd-card kd-section__block">
            <h2 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:calendar-range') }} Planifier dans l'agenda</h2>
            <p class="kd-lead" style="margin-top:0;">
                Pose toutes les séances du plan dans {{ mine ? 'ton agenda' : 'l\'agenda de ' ~ goal.owner.displayName }},
                en calant sa dernière semaine sur le jour J : Kadens calcule la date de départ.
                Le plan est associé à l'objectif au passage. À faire une seule fois par plan.
            </p>
            {% if plans is empty %}
                <div class="kd-empty">
                    {{ ux_icon('lucide:layers') }}
                    <div>{{ mine ? 'Tu n\'as pas encore de plan.' : 'Aucun plan pour cet athlète.' }} Crée un plan ci-dessus pour le planifier sur cette date.</div>
                </div>
            {% else %}
                <form method="post" action="{{ path('app_goal_prepare', {id: goal.id}) }}" class="kd-goalprepare">
                    <input type="hidden" name="_token" value="{{ csrf_token('prepare_goal' ~ goal.id) }}">
                    <div class="kd-field">
                        <label class="kd-label" for="goal-prepare-plan">Plan à poser</label>
                        <select name="planTemplate" id="goal-prepare-plan" class="kd-input kd-select" required>
                            <option value="">Choisir un plan…</option>
                            {% for plan in plans %}
                                <option value="{{ plan.id }}">{{ plan.title }}{% if plan.durationWeeks %} ({{ plan.durationWeeks }} sem.){% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="kd-btn kd-btn--secondary">
                        {{ ux_icon('lucide:calendar-plus') }} Planifier pour finir le jour J
                    </button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    {# ---------------------- SÉANCES MENANT À L'ÉCHÉANCE -------------------- #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Calendrier</p>
                <h2 class="kd-title kd-title--sm">Séances menant à l'échéance</h2>
            </div>
        </div>
        {% if leadUp is empty %}
            <div class="kd-card">
                <div class="kd-empty">
                    {{ ux_icon('lucide:calendar-off') }}
                    <div>Aucune séance planifiée avant cette date. Planifie un plan ci-dessus ou ajoute des séances au calendrier.</div>
                </div>
            </div>
        {% else %}
            <ul class="kd-goallead kd-section__block">
                {% for s in leadUp %}
                    <li class="kd-goallead__row">
                        <span class="kd-goallead__date">{{ s.scheduledDate|date('d/m') }}</span>
                        {# La liste montre des séances DATÉES : le lien ouvre la séance
                           datée (statut, réalisé), jamais la séance de bibliothèque. Ça
                           vaut aussi pour une séance libre, qui n'a pas de source. #}
                        <a href="{{ path('app_scheduled_workout_show', {id: s.id}) }}"
                           class="kd-goallead__title">{{ s.displayTitle }}</a>
                        <span class="kd-badge kd-badge--{{ s.status.value }}">{{ s.status.label }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

{% endblock %}
